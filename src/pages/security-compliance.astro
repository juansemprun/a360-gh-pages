---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
const pageTitle = 'Security & Compliance';

import {
  BinaryLock,
  BuildingShield,
  CameraCctv,
  CheckToSlot,
  FileContract,
  LaptopMobile,
  MonitorWaveform,
  PersonCircleMinus,
  PersonSign,
  ScaleBalanced,
  Server,
  ShieldCheck,
  UserShield,
} from '@assets/icons';
import gdprComplianceImg from '@assets/images/gdpr-compliance.webp';
import dataBaseImg from '@assets/images/database.webp';
---

<BaseLayout title={pageTitle}>
  <section class="pt-24 text-center md:pt-32" data-theme="dark">
    <h1 class="font-clash-display-bold mb-8 text-4xl leading-tight text-slate-800 md:text-6xl">
      Committed to<br />
      Privacy & Security
    </h1>
    <p class="mx-auto max-w-3xl text-lg text-slate-500 md:text-2xl">
      We are fully committed to providing features that help you be compliant with privacy
      regulations by taking a privacy by design approach. As well as partnering with the best in
      class security providers to keep all your data safe.
    </p>
  </section>

  <section class="my-16 p-10 md:my-20" data-theme="dark">
    <div
      class="mx-auto flex max-w-5xl flex-col items-stretch justify-between gap-8 rounded-2xl bg-slate-50 px-4 py-8 md:flex-row md:px-10"
    >
      <!-- Compliance -->
      <div class="flex flex-1 flex-col items-center gap-4 text-center md:flex-row md:text-start">
        <span
          class="inline-flex h-16 w-16 flex-shrink-0 items-center justify-center rounded-xl bg-pink-100"
        >
          <FileContract class="text-primary-600 h-10 w-10 fill-current p-1" aria-hidden="true" />
        </span>
        <div>
          <h3 class="mb-1 text-2xl font-bold text-slate-800">Compliance</h3>
          <p class="text-slate-500">
            Compliant with data protection regulations including, GDPR and CCPA acts
          </p>
          <a
            href="#compliance-title"
            class="mt-2 inline-block font-semibold text-pink-600 hover:underline"
          >
            More <span aria-hidden="true">›</span>
          </a>
        </div>
      </div>
      <!-- Security -->
      <div
        class="flex flex-1 flex-col items-center gap-4 p-10 text-center md:flex-row md:text-start"
      >
        <span
          class="inline-flex h-16 w-16 flex-shrink-0 items-center justify-center rounded-xl bg-blue-100"
        >
          <ShieldCheck class="h-10 w-10 fill-current p-1 text-blue-400" aria-hidden="true" />
        </span>
        <div>
          <h3 class="mb-1 text-2xl font-bold text-slate-800">Security</h3>
          <p class="text-slate-500">Your data is safe, secure, and always available</p>
          <a
            href="/where-is-your-data"
            class="mt-2 inline-block font-semibold text-blue-600 hover:underline"
          >
            More <span aria-hidden="true">›</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="compliance-title" class="my-16 lg:my-20" data-theme="dark">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2
        id="compliance-title"
        class="font-clash-display-semibold mb-10 text-center text-3xl text-slate-800 md:text-4xl"
      >
        Enabled compliance
      </h2>

      <div class="flex flex-col gap-10 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-3xl flex-1 space-y-10">
          <article class="flex flex-col gap-4 md:flex-row">
            <span
              class="inline-flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-pink-100"
            >
              <ScaleBalanced
                class="text-primary-600 h-10 w-10 fill-current p-1"
                aria-hidden="true"
              />
            </span>
            <div>
              <h3 class="mb-2 text-xl font-semibold text-slate-800">
                Lawful basis and transparency
              </h3>
              <p class="text-base text-slate-500">
                As part of our compliance to data protection regulation, we enter into Data
                Processing Agreements (DPAs) with all our customers. This DPA, a binding agreement
                signed between the controller and the processor when the latter processes data from
                the controller, details the standard contractual terms required under the GDPR. We
                are also transparent as regard internal organizations and processes and as regard
                the sub-processors, we are working with.
              </p>
            </div>
          </article>

          <article class="flex flex-col gap-4 md:flex-row">
            <span
              class="inline-flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-pink-100"
            >
              <BuildingShield
                class="text-primary-600 h-10 w-10 fill-current p-1"
                aria-hidden="true"
              />
            </span>
            <div>
              <h3 class="mb-2 text-xl font-semibold text-slate-800">
                Accountability and Governance
              </h3>
              <p class="text-base text-slate-500">
                Air360 has appointed a Data Protection contact to monitor GDPR compliance, assess
                data protection risks, advise on data protection impact assessments, exchange with
                clients and cooperate with regulators.
              </p>
            </div>
          </article>
        </div>

        <div class="flex flex-1 justify-center lg:justify-end">
          <Image alt="GDPR Compliance" inferSize src={gdprComplianceImg} />
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="privacy-features-title" class="my-16 md:my-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2
        id="privacy-features-title"
        class="font-clash-display-semibold mb-12 text-center text-3xl text-slate-800 md:text-4xl"
      >
        Air360 privacy features
      </h2>
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2">
        <article class="flex flex-col gap-4 md:flex-row">
          <span
            class="inline-flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-pink-100"
          >
            <UserShield class="text-primary-600 h-10 w-10 fill-current p-1" aria-hidden="true" />
          </span>
          <div>
            <h3 class="mb-2 text-lg font-semibold text-slate-800">
              Privacy by default - minimization
            </h3>
            <p class="text-slate-500">
              Air360 automatically disallows the capture of any directly identifying data that a
              user enters in an input field of your web store. In addition personal data we are
              processing are immediately pseudonymized, if not anonymized when Air360 is used
              “cookie-less.”
            </p>
          </div>
        </article>
        <article class="flex flex-col gap-4 md:flex-row">
          <span
            class="inline-flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-pink-100"
          >
            <PersonCircleMinus
              class="text-primary-600 h-10 w-10 fill-current p-1"
              aria-hidden="true"
            />
          </span>
          <div>
            <h3 class="mb-2 text-lg font-semibold text-slate-800">Exercises of right</h3>
            <p class="text-slate-500">
              We are committed to assist you in order to respondent efficiently to exercises of
              rights requests from given users, based on GDPR provisions as right of access, right
              of erasure, right etc. As regard right of erasure, Air360 offers a function that will
              allow you to delete a specific user and related sessions with just a single click. As
              regard right of access and data portability as example, You can retrieve specific user
              details simply by going through our application or using our API.
            </p>
          </div>
        </article>
        <article class="flex flex-col gap-4 md:flex-row">
          <span
            class="inline-flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-pink-100"
          >
            <PersonSign class="text-primary-600 h-10 w-10 fill-current p-1" aria-hidden="true" />
          </span>
          <div>
            <h3 class="mb-2 text-lg font-semibold text-slate-800">
              Restrict specific data acquisition
            </h3>
            <p class="text-slate-500">
              Air360 enables you to go further by also hiding explicitly parts of your pages from
              being recorded during session replays.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section aria-labelledby="secure-data-title" class="my-16 md:my-24" data-theme="dark">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 md:flex md:items-center md:gap-8 lg:px-8">
      <div>
        <h2
          id="secure-data-title"
          class="font-clash-display-semibold mb-4 text-3xl text-slate-800 md:text-4xl"
        >
          Secure data handling & protection
        </h2>
        <p class="text-primary-600 mb-1 font-bold">Limit Access to your data</p>
        <p class="text-lg text-slate-500">
          Air360 follows strict data security regulations to ensure that we secure and limit access
          to your data.
        </p>
      </div>
      <div class="mb-8 flex justify-center md:mb-0 md:justify-end">
        <Image
          src={dataBaseImg}
          alt="Database icon representing secure data storage"
          inferSize
          class=""
        />
      </div>
    </div>
  </section>

  <section aria-labelledby="security-measures-title" class="my-16 md:my-24" data-theme="dark">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2
        id="security-measures-title"
        class="font-clash-display-semibold mb-12 text-center text-3xl text-slate-800 md:text-4xl"
      >
        Air360 Security Measures
      </h2>
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2">
        <article class="flex items-start gap-4">
          <span
            class="inline-flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-pink-100"
          >
            <MonitorWaveform
              class="text-primary-600 h-10 w-10 fill-current p-1"
              aria-hidden="true"
            />
          </span>
          <div>
            <h3 class="mb-2 text-lg font-semibold text-slate-800">
              Monitoring of our Tracking pixel
            </h3>
            <p class="text-slate-500">
              Constantly conducted to detect any malicious modification and ensure its delivery,
              integrity and safety.
            </p>
          </div>
        </article>
        <article class="flex items-start gap-4">
          <span
            class="inline-flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-pink-100"
          >
            <CheckToSlot class="text-primary-600 h-10 w-10 fill-current p-1" aria-hidden="true" />
          </span>
          <div>
            <h3 class="mb-2 text-lg font-semibold text-slate-800">Security best practices</h3>
            <p class="text-slate-500">
              Reviewed by third party companies regularly when important updates are performed on
              our systems.
            </p>
          </div>
        </article>
        <article class="flex items-start gap-4">
          <span
            class="inline-flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-pink-100"
          >
            <LaptopMobile class="text-primary-600 h-10 w-10 fill-current p-1" aria-hidden="true" />
          </span>
          <div>
            <h3 class="mb-2 text-lg font-semibold text-slate-800">
              Multi-Factor Authentication (MFA)
            </h3>
            <p class="text-slate-500">
              Required for all our users to access to Air360 application adding an extra layer of
              security and keeping your accounts safe.
            </p>
          </div>
        </article>
        <article class="flex items-start gap-4">
          <span
            class="inline-flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-pink-100"
          >
            <CameraCctv class="text-primary-600 h-10 w-10 fill-current p-1" aria-hidden="true" />
          </span>
          <div>
            <h3 class="mb-2 text-lg font-semibold text-slate-800">Third-party security audits</h3>
            <p class="text-slate-500">
              Conducted regularly and before major releases, including penetration tests and
              vulnerability scans.
            </p>
          </div>
        </article>
        <article class="flex items-start gap-4">
          <span
            class="inline-flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-pink-100"
          >
            <Server class="text-primary-600 h-10 w-10 fill-current p-1" aria-hidden="true" />
          </span>
          <div>
            <h3 class="mb-2 text-lg font-semibold text-slate-800">
              Customer data processed & stored in the EU
            </h3>
            <p class="text-slate-500">
              Although Air360’s headquarters are located in Japan, Air360 core systems are hosted on
              OVHcloud and Amazon Web Services (AWS) servers located in France and Ireland and
              leverage all the security and compliance provided by OVHcloud/AWS: ISO (9001, 27001,
              27017, and 27018), SOC 1, 2, and 3, PCI DSS.
            </p>
          </div>
        </article>
        <article class="flex items-start gap-4">
          <span
            class="inline-flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-pink-100"
          >
            <BinaryLock class="text-primary-600 h-10 w-10 fill-current p-1" aria-hidden="true" />
          </span>
          <div>
            <h3 class="mb-2 text-lg font-semibold text-slate-800">State-of-the-art encryption</h3>
            <p class="text-slate-500">
              Used in all Air360 products for data in transit and at rest.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
