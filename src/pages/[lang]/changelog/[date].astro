---
import type { GetStaticPaths, InferGetStaticParamsType, InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

import type { LanguageCode } from '@/config/language';
import { getDateFormatter } from '@/i18n';

import BaseLayout from '@/layouts/BaseLayout.astro';

import GradientText from '@/components/ui/GradientText.astro';

import { ArrowLeft } from 'lucide-react';

export const getStaticPaths = (async () => {
  const posts = await getCollection('changelog');

  const paths = posts.map((post) => {
    const [lang, ...slug] = post.id.split('/');
    const date = slug.join('/');

    if (!date) {
      throw new Error(`Invalid changelog entry: ${post.id} - missing date segment`);
    }

    return {
      params: { lang, date },
      props: post,
    };
  });

  return paths;
}) satisfies GetStaticPaths;

type Params = InferGetStaticParamsType<typeof getStaticPaths>;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang, date } = Astro.params as Params;
const post = Astro.props as Props;

const formatDate = getDateFormatter(lang as LanguageCode);

const formattedDate = formatDate(post.data.publishedAt, {
  month: 'long',
  day: '2-digit',
  year: 'numeric',
});

// Render the markdown content
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} lang={lang}>
  <article class="container-custom py-32" data-theme="dark">
    <nav class="mx-auto mb-8 max-w-3xl">
      <a
        href={`${import.meta.env.BASE_URL}/${lang}/changelog`}
        class="text-muted-foreground inline-flex items-center gap-2 text-sm transition duration-200 hover:text-black"
      >
        <ArrowLeft size={16} aria-hidden="true" />
        <span>Back to Changelog</span>
      </a>
    </nav>

    <header class="mx-auto flex max-w-3xl flex-col gap-4">
      <GradientText>
        <h1 class="font-clash-display-bold text-4xl tracking-wide">
          {post.data.title}
        </h1>
      </GradientText>

      <div class="my-5 flex items-center gap-3 text-sm md:text-base">
        <p>
          <span class="font-semibold">Air360 Team</span>
          <span>on </span>
          <time datetime={post.data.publishedAt.toISOString()}>
            {formattedDate}
          </time>
        </p>
      </div>

      <Image
        src={post.data.headerImage}
        alt={post.data.title}
        width={1280}
        height={720}
        class="mb-8 mt-4 aspect-video w-full rounded-lg object-cover"
      />
    </header>

    <div class="prose prose-lg mx-auto max-w-3xl text-pretty">
      <Content />
    </div>
  </article>
</BaseLayout>
