---
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('use-cases');

  const paths = pages.map((page) => {
    const [lang, ...slug] = page.slug.split('/');

    return { params: { lang, slug: slug.join('/') || undefined }, props: page };
  });

  return paths;
}

const { lang, slug } = Astro.params;

console.log('lang, slug:', lang, slug);

const useCasesEntry = await getEntry('use-cases', `${lang}/${slug}`);
console.log('useCasesEntry:', useCasesEntry);

import BaseLayout from '@layouts/BaseLayout.astro';

const pageTitle = 'Gaming Companies';

const { Content } = await render(useCasesEntry);
---

<BaseLayout title={pageTitle}>
  <div
    data-theme="light"
    class="bg-gradient-primary-darker absolute inset-0 -z-10 h-full w-full items-center px-5 py-24"
  >
  </div>
  <div class="container-custom mx-auto my-32 md:my-20">
    <Content />
  </div>
</BaseLayout>
