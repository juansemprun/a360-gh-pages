---
import { getCollection, getEntry, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

import BaseLayout from '@layouts/BaseLayout.astro';
import CallToAction from '@/components/ui/use-cases/CallToAction.astro';

export const getStaticPaths = (async () => {
  const pages = await getCollection('use-cases');

  const paths = pages.map((page) => {
    const [lang, ...slug] = page.id.split('/');

    return {
      params: { lang, slug: slug.join('/') || undefined },
      props: { page },
    };
  });

  return paths;
}) satisfies GetStaticPaths;

const { lang, slug } = Astro.params;

const useCaseEntry = await getEntry('use-cases', `${lang}/${slug}`);

if (!useCaseEntry) {
  return Astro.redirect(`/${lang}/404`);
}

const title = useCaseEntry.data.title;
const description = useCaseEntry.data.description;
const type = useCaseEntry.data.type;

const { Content } = await render(useCaseEntry);
---

<BaseLayout title={title} description={description} lang={lang}>
  {
    type === 'industry' ? (
      <>
        <div
          data-theme="light"
          class="bg-gradient-primary-darker-variant absolute inset-0 -z-10 h-full w-full items-center px-5 py-24"
        />
        <div class="container-custom mx-auto my-32 md:my-20">
          <Content />
        </div>
      </>
    ) : (
      <>
        <section class="pb-16" data-theme="dark">
          <div class="container-custom">
            <Content />
          </div>
        </section>

        <CallToAction />
      </>
    )
  }
</BaseLayout>
