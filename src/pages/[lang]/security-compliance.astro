---
import { getEntry, render } from 'astro:content';
import type { GetStaticPaths, InferGetStaticParamsType } from 'astro';

import BaseLayout from '@/layouts/BaseLayout.astro';

import { languageCodes } from '@/config/language';

export const getStaticPaths = (async () => {
  return languageCodes.map((lang) => ({
    params: { lang },
  }));
}) satisfies GetStaticPaths;

type Params = InferGetStaticParamsType<typeof getStaticPaths>;

const { lang } = Astro.params as Params;

const securityComplianceEntry = await getEntry('pages', `${lang}/security-compliance`);

if (!securityComplianceEntry) {
  return Astro.redirect('/404');
}

const { Content } = await render(securityComplianceEntry);
---

<BaseLayout
  title={securityComplianceEntry.data.title}
  description={securityComplianceEntry.data.description}
  lang={lang}
>
  <section class="pb-16" data-theme="dark">
    <div class="container-custom">
      <Content />
    </div>
  </section>
</BaseLayout>
