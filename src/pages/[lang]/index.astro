---
import { getEntry } from 'astro:content';

import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import StaticFeatures from '@components/StaticFeatures.astro';
import DynamicFeatures from '@components/DynamicFeatures.astro';
import TwoColumnText from '@components/TwoColumnText.astro';

import { languageCodes } from '@config/language';

const { lang } = Astro.params;
const heroEntry = await getEntry('hero', `${lang}/hero`);

if (!heroEntry) {
  throw new Error(`Hero entry not found for language: ${lang}`);
}

export async function getStaticPaths() {
  return languageCodes.map((lang) => ({
    params: { lang },
  }));
}
---

<BaseLayout title="Air360 | Simplify UX analysis, boost conversion">
  <Hero heroEntry={heroEntry} lang={lang} />
  <StaticFeatures />
  <DynamicFeatures
    title="Image on the bottom"
    layout="image-bottom"
    className="hidden py-48 lg:block"
    dataTheme="dark"
  />
  <TwoColumnText />
  <StaticFeatures />
  <DynamicFeatures
    title="Image on the top"
    layout="image-top"
    className="hidden py-48 lg:block"
    dataTheme="dark"
    gradient="from-rose-500 to-orange-400"
  />
</BaseLayout>
