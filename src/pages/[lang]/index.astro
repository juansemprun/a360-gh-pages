---
import { getEntry } from 'astro:content';

import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import StaticFeatures from '@components/StaticFeatures.astro';
import DynamicFeatures from '@components/DynamicFeatures.astro';
import TwoColumnText from '@components/TwoColumnText.astro';

import { Testimonials } from '@/components/react/Testimonials';

import { languageCodes } from '@config/language';

const { lang } = Astro.params;
const heroEntry = await getEntry('hero', `${lang}/hero`);

if (!heroEntry) {
  return Astro.redirect('/404');
}

export async function getStaticPaths() {
  return languageCodes.map((lang) => ({
    params: { lang },
  }));
}
---

<BaseLayout
  description="Air360 is the UX analytics platform that uncovers hidden user behaviors and decodes the end-to-end user experience, speeding up CRO efforts."
  lang={lang}
  title="Air360 | Simplify UX analysis, boost conversion"
>
  <Hero heroEntry={heroEntry} />
  <StaticFeatures />
  <DynamicFeatures
    title="Image on the bottom"
    layout="image-bottom"
    className="hidden py-48 lg:block"
    dataTheme="dark"
  />
  <TwoColumnText />
  <StaticFeatures />
  <DynamicFeatures
    title="Image on the top"
    layout="image-top"
    className="hidden py-48 lg:block"
    dataTheme="dark"
    gradient="from-rose-500 to-orange-400"
  />
  <Testimonials client:visible />
</BaseLayout>
