---
import { getEntry } from 'astro:content';

import BaseLayout from '@layouts/BaseLayout.astro';
// import DynamicFeatures from '@components/DynamicFeatures.astro';
import FeatureCardsSection from '@/components/FeatureCardsSection.astro';
import Hero from '@components/Hero.astro';
import StaticFeatures from '@components/StaticFeatures.astro';
import TwoColumnText from '@components/TwoColumnText.astro';

import Testimonials from '@/components/Testimonials.astro';

import { languageCodes } from '@config/language';

const { lang } = Astro.params;
const heroEntry = await getEntry('hero', `${lang}/hero`);

if (!heroEntry) {
  return Astro.redirect('/404');
}

export async function getStaticPaths() {
  return languageCodes.map((lang) => ({
    params: { lang },
  }));
}
---

<BaseLayout
  description="Air360 is the UX analytics platform that uncovers hidden user behaviors and decodes the end-to-end user experience, speeding up CRO efforts."
  lang={lang}
  title="Air360 | Simplify UX analysis, boost conversion"
>
  <Hero heroEntry={heroEntry} />
  <StaticFeatures />
  <FeatureCardsSection />
  <TwoColumnText />
  <StaticFeatures />
  <FeatureCardsSection />
  <Testimonials lang={lang} />
  <FeatureCardsSection />
</BaseLayout>
