---
import { getEntry, render } from 'astro:content';

import BaseLayout from '@layouts/BaseLayout.astro';

import { languageCodes } from '@config/language';

const { lang } = Astro.params;
const homeEntry = await getEntry('pages', `${lang}/home`);

if (!homeEntry) {
  return Astro.redirect('/404');
}

export async function getStaticPaths() {
  return languageCodes.map((lang) => ({
    params: { lang },
  }));
}

const { Content } = await render(homeEntry);

const { title, description } = homeEntry.data;
---

<BaseLayout description={description} lang={lang} title={title}>
  <Content />
</BaseLayout>
