---
import { getEntry, render } from 'astro:content';

import { languageCodes } from '@config/language';

import BaseLayout from '@layouts/BaseLayout.astro';
import UnderlineTextDecoration from '@assets/graphics/underline-text-decoration.svg';

const { lang } = Astro.params;
const aboutEntry = await getEntry('pages', `${lang}/about`);

if (!aboutEntry) {
  return Astro.redirect('/404');
}

const title = aboutEntry?.data?.title;
const description = aboutEntry?.data?.description;

export async function getStaticPaths() {
  return languageCodes.map((lang) => ({
    params: { lang },
  }));
}

const { Content } = await render(aboutEntry);
---

<BaseLayout title={title} description={description} lang={lang}>
  <div class="container-custom">
    <section class="mx-auto my-24 max-w-4xl px-5 md:my-36" data-theme="dark">
      <div class="mb-8 flex flex-col items-center">
        <h1
          class="font-clash-display-bold mb-8 text-center text-4xl leading-tight text-slate-800 md:text-6xl"
        >
          {title}
          <UnderlineTextDecoration class="mx-auto mt-2 max-w-96" />
        </h1>
      </div>
