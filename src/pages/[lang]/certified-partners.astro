---
import { Image } from 'astro:assets';

import BaseLayout from '@/layouts/BaseLayout.astro';
import CallToAction from '@/components/ui/use-cases/CallToAction.astro';
import PartnersHero from '@/components/ui/certified-partners/PartnersHero.astro';

import { Badge } from '@/components/ui/shadcn/badge';
import GradientText from '@/components/ui/GradientText.astro';
import { Card } from '@/components/ui/shadcn/card';

import MochiMechanic from '@/assets/images/mochi/svg/mechanic.svg';

import { ArrowRight } from 'lucide-react';

import { languageCodes } from '@/config/language';

const { lang } = Astro.params;
const pageTitle = 'Certified Partners';
const pageDescription =
  'Gain deeper insights into your digital experience with an Air360 Expert. Every consultancy, agency, and freelancer in our directory has been professionally trained and certified by Air360 to help you maximize your analytics potential.';

export async function getStaticPaths() {
  return languageCodes.map((lang) => ({
    params: { lang },
  }));
}

interface Post {
  id: string;
  title: string;
  summary: string;
  label: string;
  author: string;
  published: string;
  url: string;
  image: string;
}

