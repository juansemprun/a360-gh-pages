const heading = 'Find your expert';
const description =
  'Gain deeper insights into your digital experience with an Air360 Expert. Every consultancy, agency, and freelancer in our directory has been professionally trained and certified by Air360 to help you maximize your analytics potential.';
---

<BaseLayout title={pageTitle} description={pageDescription} lang={lang}>
  <PartnersHero />
  <section class="pb-16" data-theme="dark">
    <div class="container-custom">
      <div
        class="relative mx-auto flex flex-col justify-between gap-6 overflow-hidden rounded-xl border bg-gradient-to-r from-[#2d92e9] to-[#644ad5] md:flex-row"
      >
        <div class="max-w-xl self-center p-6 md:p-12">
          <h2 class="font-clash-display-bold text-4xl text-white md:text-5xl">
            {heading}
          </h2>
          <p class="mt-4 font-semibold text-white md:text-lg">
            {description}
          </p>
        </div>
        <div class="hidden md:block">
          <Image
            src={MochiMechanic}
            alt="Mochi using Air360"
            class="h-16 w-full object-cover object-center sm:h-80 md:h-full md:w-96 lg:w-[32rem]"
          />
        </div>
      </div>

      <div class="space-y-12 pt-16">
        {
          agencies.map((agency) => (
            <Card key={agency.id} className="overflow-hidden border-0 bg-transparent shadow-none">
              <div class="flex flex-col gap-12 sm:flex-row">
                <div class="shrink-0">
                  <img
                    src={agency.logo.src}
                    alt={agency.logo.alt}
                    class="aspect-16/9 w-full object-cover object-center sm:w-[260px]"
                  />
                </div>
                <div class="flex-1 space-y-6">
                  <h3 class="text-xl font-bold leading-tight lg:text-2xl">{agency.name}</h3>
                  <p class="text-muted-foreground text-base">{agency.description}</p>
                  <div class="text-muted-foreground flex items-center gap-3 text-sm">
                    {agency.tags.map((tag) => (
                      <Badge
                        variant="secondary"
                        className="border-primary-300 border bg-white h-fit px-3 py-1 text-sm"
                      >
                        {tag}
                      </Badge>
                    ))}
                    {/* <span>{agency.name}</span>
                    <span>{agency.published}</span> */}
                  </div>
                  <a
                    href={`/website/${lang}/request-expert`}
                    class="text-primary group inline-flex items-center hover:underline"
                  >
                    Request expert
                    <ArrowRight className="ml-2 size-4 transition duration-200 ease-in-out group-hover:translate-x-0.5" />
                  </a>
                </div>
              </div>
            </Card>
          ))
        }
      </div>
    </div>
  </section>
  <CallToAction />
</BaseLayout>
