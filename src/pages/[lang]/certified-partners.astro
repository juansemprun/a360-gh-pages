---
import { getEntry, render } from 'astro:content';
import type { GetStaticPaths, InferGetStaticParamsType } from 'astro';

import BaseLayout from '@/layouts/BaseLayout.astro';
import CallToAction from '@/components/ui/use-cases/CallToAction.astro';

import { languageCodes } from '@/config/language';

export const getStaticPaths = (async () => {
  return languageCodes.map((lang) => ({
    params: { lang },
  }));
}) satisfies GetStaticPaths;

type Params = InferGetStaticParamsType<typeof getStaticPaths>;

const { lang } = Astro.params as Params;

const certifiedPartnersEntry = await getEntry('pages', `${lang}/certified-partners`);

if (!certifiedPartnersEntry) {
  return Astro.redirect('/404');
}

const { Content } = await render(certifiedPartnersEntry);
---

<BaseLayout
  title={certifiedPartnersEntry.data.title}
  description={certifiedPartnersEntry.data.description}
  lang={lang}
>
  <section class="pb-16" data-theme="dark">
    <div class="container-custom">
      <Content />
    </div>
  </section>

  <CallToAction />
</BaseLayout>
