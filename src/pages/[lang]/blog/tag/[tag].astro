---
import { getCollection } from 'astro:content';
import { languageCodes } from '@config/language';

import BlogNav from '@ui/blog/BlogNav.astro';
import BlogHeader from '@ui/blog/BlogHeader.astro';
import BlogPostList from '@ui/blog/BlogPostList.astro';

import type { InferGetStaticParamsType, InferGetStaticPropsType, GetStaticPaths } from 'astro';

import BaseLayout from '@layouts/BaseLayout.astro';

// Efficiently build all tag/language static paths
export const getStaticPaths = (async () => {
  const allPosts = await getCollection('blog');
  const uniquePostTags = Array.from(new Set(allPosts.flatMap((post) => post.data.tags || [])));

  return languageCodes.flatMap((lang) =>
    uniquePostTags.map((tag) => {
      // Filter posts by BOTH language and tag
      const posts = allPosts
        .filter((post) => post.slug.startsWith(lang) && post.data.tags?.includes(tag))
        .map((post) => {
          const [langPart, slug] = post.slug.split('/');
          return {
            title: post.data.title,
            published: post.data.published,
            readingTime: post.data.readingTime,
            image: post.data.image,
            metaDesc: post.data.metaDesc,
            tags: post.data.tags,
            url: `/website/${langPart}/blog/${slug}`,
            slug: slug,
          };
        });

      return {
        params: { lang, tag },
        props: { posts },
      };
    }),
  );
}) satisfies GetStaticPaths;

type Params = InferGetStaticParamsType<typeof getStaticPaths>;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { posts } = Astro.props as Props;
const { lang, tag } = Astro.params as Params;

const pageTitle = 'Blog';
const pageDescription = `Posts about the latest trends in eCommerce UX, tips and tricks for improving conversion rates, featuring tag: ${tag}.`;
---

<BaseLayout title={pageTitle} lang={lang} description={pageDescription}>
  <section class="container-custom py-32" data-theme="dark">
    <div class="flex flex-col gap-10">
      <BlogHeader lang={lang} />
      <BlogNav lang={lang} />
    </div>
    <BlogPostList posts={posts} lang={lang} />
  </section>
</BaseLayout>
