---
import type { GetStaticPaths, InferGetStaticParamsType, InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import { format, type Locale } from 'date-fns';
import { fr, ja } from 'date-fns/locale';

import BaseLayout from '@layouts/BaseLayout.astro';
import GradientText from '@ui/GradientText.astro';
import MochiComputer from '@assets/images/mochi/svg/mochi-computer.svg';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog');

  return posts.map((post) => {
    const [lang, ...slugParts] = post.slug.split('/');
    const slug = slugParts.join('/');

    if (!slug) {
      throw new Error(`Invalid blog entry: ${post.id} - missing slug segment`);
    }

    return {
      params: { lang, slug },
      props: post,
    };
  });
}) satisfies GetStaticPaths;

type Params = InferGetStaticParamsType<typeof getStaticPaths>;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang, slug } = Astro.params as Params;
const post = Astro.props as Props;

const localeMap: Record<string, Locale | undefined> = {
  fr: fr,
  ja: ja,
};

// Render the markdown content
const { Content } = await post.render();
---

<BaseLayout title={post.data.title} description={post.data.metaDesc} lang={lang}>
  <article class="container-custom py-32" data-theme="dark">
    <!-- Back navigation -->
    <nav class="mx-auto mb-8 max-w-3xl">
      <a
        href={`${import.meta.env.BASE_URL}/${lang}/blog`}
        class="text-muted-foreground inline-flex items-center gap-2 text-sm transition duration-200 hover:text-black"
      >
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        <span>Back to Blog</span>
      </a>
    </nav>

    <!-- Article header -->
    <header class="mx-auto flex max-w-3xl flex-col gap-4">
      <GradientText animationSpeed={30}>
        <h1 class="font-clash-display-bold text-4xl tracking-wide md:text-5xl">
          {post.data.title}
        </h1>
      </GradientText>

      <div class="my-5 flex items-center gap-3 text-sm md:text-base">
        <Image src={MochiComputer} alt="" width={32} height={32} />
        <p>
          <span class="font-semibold">Air360 Team</span>
          {' '}
          <span>on </span>
          <time datetime={post.data.published.toISOString()}>
            {format(post.data.published, 'MMMM d, yyyy', { locale: localeMap[lang] })}
          </time>
        </p>
      </div>

      <Image
        src={post.data.image}
        alt={post.data.title}
        class="mb-8 mt-4 aspect-video w-full rounded-lg object-cover"
      />
    </header>

    <!-- Article content -->
    <div class="prose prose-lg mx-auto max-w-3xl text-pretty">
      <Content />
    </div>
  </article>
</BaseLayout>
