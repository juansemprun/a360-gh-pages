---
import BaseLayout from '@/layouts/BaseLayout.astro';

import GradientText from '@/components/ui/GradientText.astro';
import { Button } from '@/components/ui/shadcn/button';

import { languageCodes } from '@/config/language';

const { lang } = Astro.params;
const pageTitle = 'Request an Air360 Expert';
const pageDescription =
  'Connect with a certified Air360 expert to elevate your analytics and digital experience.';

export async function getStaticPaths() {
  return languageCodes.map((lang) => ({
    params: { lang },
  }));
}
---

<BaseLayout lang={lang} title={pageTitle} description={pageDescription}>
  <section class="py-16" data-theme="dark">
    <div class="mx-auto max-w-3xl space-y-6 text-center">
      <h1
        class="font-heading text-4xl font-bold leading-tight tracking-tighter sm:text-5xl lg:text-6xl"
      >
        <GradientText>Request an Air360 Expert</GradientText>
      </h1>
      <p class="text-muted-foreground text-lg sm:text-xl">
        Connect with a certified Air360 expert to elevate your analytics and digital experience.
      </p>
      <div>
        <Button rel="noopener noreferrer" size="lg"> Request expert </Button>
      </div>
    </div>
  </section>
  <section class="container pb-20 lg:pb-32">
    <div class="mx-auto max-w-4xl space-y-12">
      <div class="space-y-6 text-center">
        <h2
          class="font-heading text-3xl font-bold leading-tight tracking-tighter sm:text-4xl lg:text-5xl"
        >
          Our Certified Partners
        </h2>
        <p class="text-muted">
          These consultants, agencies and freelancers have been trained and certified by Air360 to
          help you get the most out of your digital experience analysis.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
