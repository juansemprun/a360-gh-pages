---
import { languageCodes } from '@config/language';

import { Banknote, Repeat, ShoppingBag } from 'lucide-react';

import { AspectRatio } from '@ui/shadcn/aspect-ratio';

import {
  ProductColor,
  DubreuilColor,
  OlympiqueLyonnaisColor,
  AirCaraibesColor,
} from '@/assets/brand-logos';

import Circles from '@assets/graphics/circles.svg';

import BaseLayout from '@layouts/BaseLayout.astro';
import GradientText from '@ui/GradientText.astro';
import Marquee from '@components/Marquee.astro';
import CallToAction from '@ui/use-cases/CallToAction.astro';
import RequestDemoComponent from '@components/RequestDemo';
import { Image } from 'astro:assets';

import g2 from '@assets/badges/g2.webp';
import sourceForge from '@assets/badges/source-forge.svg';
import topBusinessSoftware from '@assets/badges/top-business-software.svg';
import crozdeskHappiestUsers from '@assets/badges/crozdesk-happiest-users.webp';
import crozdeskQualityChoice from '@assets/badges/crozdesk-quality-choice.webp';
import softwareSuggest from '@assets/badges/software-suggest.webp';
import capterra from '@assets/badges/capterra.webp';

const { lang } = Astro.params;

export async function getStaticPaths() {
  return languageCodes.map((lang) => ({
    params: { lang },
  }));
}

const title = 'Pricing';
const description = 'Simple, transparent pricing that scales with your business.';

const CUSTOMER_DATA = {
  company: {
    logo: 'https://deifkwefumgah.cloudfront.net/shadcnblocks/block/logos/company/fictional-company-logo-8.svg',
    name: '',
  },
  stats: [
    {
      number: '45%',
      text: 'improvement in onboarding completion',
    },
    {
      number: '61%',
      text: 'reduction in time-to-value',
    },
    {
      number: '3x',
      text: 'increase in user activation',
    },
  ],
  author: {
    name: 'Sarah Williams',
    image: 'https://deifkwefumgah.cloudfront.net/shadcnblocks/block/avatar-1.webp',
    role: 'CTO, monzo',
  },
  title: 'WHY INDUSTRY EXPERTS CHOOSE AIR360',
  summary:
    'lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.',
  link: '#',
};

const services = [
  {
    title: 'Pipeline Conversion',
    items: ['Market Research', 'User Personas'],
    number: '4X',
    icon: ProductColor,
  },
  {
    title: 'Forecast Accuracy',
    items: ['UI/UX Design', 'Prototyping', 'Interaction Design'],
    number: '95%',
    icon: DubreuilColor,
  },
  {
    title: 'Email Response Rates',
    items: ['Frontend Dev', 'Backend Dev'],
    number: '80%+',
    icon: OlympiqueLyonnaisColor,
  },
];

const badges = [
  {
    title: 'Source Forge',
    image: '',
  },
];
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero Section -->
  <section
    class="relative overflow-hidden py-32 font-sans after:absolute after:bottom-0 after:left-0 after:block after:h-20 after:w-full after:bg-[linear-gradient(var(--color-transparent),var(--color-white))] after:content-[''] md:py-40"
    data-theme="dark"
  >
    <div class="container-custom relative">
      <Circles
        class="absolute right-[-86.25rem] top-[-68.75rem] z-[-1] block aspect-square h-auto w-[181.25rem] max-w-none fill-white stroke-indigo-200/30"
      />
      <div class="grid grid-cols-1 items-center justify-center gap-16 lg:grid-cols-2">
        <div class="flex flex-col gap-6">
          <GradientText
            animationSpeed={15}
            class="font-clash-display-bold text-5xl transition duration-300 md:text-7xl"
            showBorder={true}
            colors={['#2d92e9', '#644ad5', '#c147ac', '#f04d66', '#fd7043']}
          >
            <h1 class="font-clash-display-bold text-4xl leading-tight xl:text-5xl">
              GET THE SCOOP ON AIR360 PRICING
            </h1>
          </GradientText>
          <p class="text-2xl leading-snug text-slate-700">
            Air360's pricing model depends on a few factors specific to your team.
          </p>
          <ul class="mb-4 list-inside list-disc space-y-2 text-lg leading-8 text-slate-700">
            <li>Licenses are priced per user</li>
            <li>There is a platform fee based on the number of users supported</li>
            <li>You can integrate your existing tech stack for free.</li>
          </ul>
          <p class="text-xl leading-snug text-slate-700">
            We'd love to prepare a customized proposal for you! Simply fill out the form to get
            started.
          </p>

          <!-- Badges -->
          <h5 class="text-muted-foreground my-5 text-xl font-bold">
            The Undisputed Leader in Revenue Intelligence
          </h5>
          <div class="grid grid-cols-4 items-center gap-y-5">
            <Image src={g2} alt="Air360 G2 Badge" class="h-20 w-auto" />
            <Image
              src={topBusinessSoftware}
              alt="Air360 Top Business Software Badge"
              class="h-20 w-auto"
            />
            <Image
              src={crozdeskHappiestUsers}
              alt="Air360 Crozdesk Happiest Users Badge"
              class="h-20 w-auto"
            />
            <Image
              src={crozdeskQualityChoice}
              alt="Air360 Crozdesk Quality Choice Badge"
              class="h-20 w-auto"
            />
            <Image src={sourceForge} alt="Air360 Source Forge Badge" class="h-20 w-auto" />
            <Image src={softwareSuggest} alt="Air360 Software Suggest Badge" class="h-20 w-auto" />
            <Image src={capterra} alt="Air360 Capterra Badge" class="h-auto w-auto" />
          </div>
        </div>
        <div class="justify-self-center">
          <div
            class="bg-background flex aspect-square flex-col rounded-xl border p-3 shadow-md sm:w-[22.625rem]"
          >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee Section -->
  <section class="py-20" data-theme="dark">
    <h5 class="text-muted-foreground py-5 text-center text-sm tracking-wide">
      SOME OF OUR CUSTOMERS
    </h5>
    <Marquee theme="dark" />
  </section>

  <section class="py-10">
    <div class="container-custom flex flex-col items-center gap-10">
      <GradientText
        animationSpeed={15}
        class="font-clash-display-bold text-5xl transition duration-300 md:text-7xl"
        showBorder={true}
        colors={['#2d92e9', '#644ad5', '#c147ac', '#f04d66', '#fd7043']}
      >
        <h2 class="font-clash-display-bold text-center text-4xl leading-tight xl:text-5xl">
          Book a demo!
        </h2>
      </GradientText>
      <RequestDemoComponent client:load />
    </div>
  </section>

  <!-- Customer Section -->
  <section class="py-20" data-theme="dark">
    <div class="container-custom">
      <div class="flex w-full flex-col items-stretch justify-between gap-5 p-3 lg:flex-row">
        <div class="bg-background flex w-full max-w-[30rem] flex-col gap-10 p-3">
          <div>
            <AirCaraibesColor class="w-48" />
          </div>
          <div class="flex w-full flex-col gap-8 sm:flex-row">
            {
              CUSTOMER_DATA.stats.map((item, i) => (
                <div class="flex flex-col gap-1">
                  <div class="text-xl font-semibold">
                    <GradientText
                      animationSpeed={20}
                      colors={['#2d92e9', '#644ad5', '#c147ac', '#f04d66', '#fd7043']}
                    >
                      <span class="font-clash-display-bold text-lg tracking-wide md:text-2xl">
                        {item.number}
                      </span>
                    </GradientText>
                  </div>
                  <div class="text-muted-foreground text-sm font-medium">{item.text}</div>
                </div>
              ))
            }
          </div>
        </div>
        <div class="flex max-w-[32rem] flex-col gap-5">
          <h2 class="font-clash-display-bold text-xl leading-none md:text-3xl lg:text-4xl">
            <GradientText
              animationSpeed={20}
              colors={['#2d92e9', '#644ad5', '#c147ac', '#f04d66', '#fd7043']}
            >
              <span>{CUSTOMER_DATA.title}</span>
            </GradientText>
          </h2>
          <p class="text-lg font-medium">
            {CUSTOMER_DATA.summary}
          </p>
          <div class="shrink-0">
            <!-- <Button asChild variant="outline" size="lg">
              <a href={CUSTOMER_DATA.link}>
                Read Story
                <ArrowRight />
              </a>
            </Button> -->
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Customer Section 2 -->

  <section class="py-20" data-theme="dark">
    <div class="container-custom">
      <div
        class="flex w-full flex-col items-center justify-between gap-20 rounded-[.5rem] p-3 md:p-10 lg:flex-row"
      >
        <div class="w-full space-y-10">
          {
            services.map(({ number, title, icon: Icon }) => (
              <div class="flex items-center justify-between border-b border-[#644ad5] pb-6">
                <div>
                  <GradientText
                    animationSpeed={20}
                    colors={['#2d92e9', '#644ad5', '#c147ac', '#f04d66', '#fd7043']}
                  >
                    <span class="font-clash-display-bold text-lg md:text-2xl">{number}</span>
                  </GradientText>
                </div>

                <div class="flex items-center gap-4">
                  <h2 class="text-sm font-medium">{title}</h2>
                </div>

                <div class="w-14">
                  <Icon />
                </div>
              </div>
            ))
          }
        </div>
        <div
          class="flex max-w-[32rem] flex-col gap-5 rounded-lg bg-gradient-to-r from-[#2d92e9] to-[#644ad5] p-10 shadow-lg"
        >
          <h2
            class="font-clash-display-bold text-xl leading-none text-white md:text-3xl lg:text-4xl"
          >
            {CUSTOMER_DATA.title}
          </h2>
          <p class="text-lg font-medium text-white">
            {CUSTOMER_DATA.summary}
          </p>
          <div class="shrink-0">
            <!-- <Button asChild variant="outline" size="lg">
              <a href={CUSTOMER_DATA.link}>
                Read Story
                <ArrowRight />
              </a>
            </Button> -->
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CallToAction />
</BaseLayout>
