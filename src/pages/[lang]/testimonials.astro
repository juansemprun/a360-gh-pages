---
import { getEntry, render } from 'astro:content';
import { languageCodes } from '@config/language';
import BaseLayout from '@/layouts/BaseLayout.astro';

const { lang } = Astro.params;

export async function getStaticPaths() {
  return languageCodes.map((lang) => ({
    params: { lang },
  }));
}

// Get testimonials page content
const pageEntry = await getEntry('pages', `${lang}/testimonials`);

if (!pageEntry) {
  return Astro.redirect(`/${lang}/404`);
}

const { title, description } = pageEntry.data;

// Render the MDX content
const { Content } = await render(pageEntry);
---

<BaseLayout title={title} description={description} lang={lang}>
  <section class="container mx-auto max-w-7xl px-4 py-10 md:px-6" data-theme="dark">
    <Content />
  </section>
</BaseLayout>
