---
import BaseLayout from '@layouts/BaseLayout.astro';

import Testimonial from '@ui/use-cases/Testimonial.astro';
import ListSummary from '@ui/use-cases/ListSummary.astro';

import CallToAction from '@ui/use-cases/CallToAction.astro';
const pageTitle = 'E-commerce Companies';

const highlightsList = [
  {
    title: 'Create experiences that convert',
    text: 'Level up your user engagement and turn casual visitors into committed fans. Segment users and deliver tailored shopping experiences with Air360!',
  },
  {
    title: 'The best possible version of every page',
    text: 'Every click counts! Ensure every page is optimized for peak performance. Refine interactions to keep gamers immersed with Air360.',
  },
  {
    title: 'Simplify the buying experience',
    text: 'Don’t let gamers quit before checkout. Air360 highlight where they drop off, helping you streamline the process and maximize purchases.',
  },
  {
    title: 'Keep your site running smoothly',
    text: 'No lag, no frustration! Air360 reveals your UX issues so you fix issues fast and keep things humming.',
  },
  {
    title: 'Keep your customers happy',
    text: 'Help players find the games and upgrades they love, and keep them coming back for more. Air360 optimize visibility and engagement to drive loyalty.',
  },
];
---

<BaseLayout title={pageTitle}>
  <div class="container-custom" data-theme="dark">
    <section class="mx-auto my-32 max-w-5xl px-5 md:my-36">
      <h1
        class="font-clash-display-bold text-center text-2xl leading-tight text-slate-700 md:text-6xl"
      >
        Create the best possible <br />
        <mark class="bg-primary-500 p-1 text-white">online shopping</mark> experience
      </h1>

      <Testimonial />

      <section class="space-y-10">
        {
          highlightsList.map(({ title, text }) => (
            <div>
              <h3 class="font-clash-display-bold mb-2.5 text-xl text-slate-600 md:text-2xl">
                {title}
              </h3>
              <p class="text-base text-slate-600 md:text-lg">{text}</p>
            </div>
          ))
        }
      </section>

      <section class="my-28 flex flex-col justify-center">
        <h2
          class="font-clash-display-bold mb-10 text-center text-2xl leading-tight text-slate-600 md:text-3xl"
        >
          Want to see how <mark class="bg-primary-500 p-1 text-white">easy</mark> it is?
        </h2>
        <video
          class="h-auto w-full rounded-2xl shadow-lg transition-opacity duration-300"
          autoplay
          loop
          muted
          playsinline
        >
          <source
            src="https://cdn.loom.com/sessions/thumbnails/ec06bf3738f64c8e960b2c0eccaf89b0-00001.mp4"
            type="video/mp4"
          />
          Sorry, your browser does not support embedded videos.
        </video>
      </section>

      <ListSummary />
      <CallToAction />
    </section>
  </div>
</BaseLayout>
