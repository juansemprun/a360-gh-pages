---
import BaseLayout from '@layouts/BaseLayout.astro';

import CallToAction from '@ui/use-cases/CallToAction.astro';
import Highlights from '@ui/use-cases/Highlights.astro';
import HighlightsSummary from '@ui/use-cases/HighlightsSummary.astro';
import Testimonial from '@ui/use-cases/Testimonial.astro';

const pageTitle = 'Luxury brands';

const highlightsList = [
  {
    title: 'Create experiences that convert',
    text: 'Give your customers the red-carpet treatment online and see how exclusivity drives engagement. Segment visitors and tailor premium experiences with Air360!',
  },
  {
    title: 'The best possible version of every page',
    text: 'Every interaction is a reflection of your brand—make it flawless. Elevate every page to match the luxury your customers expect with Air360.',
  },
  {
    title: 'Simplify the buying experience',
    text: 'Don’t let your customers get lost on the way to checkout. Air360 identify where shoppers hesitate, helping you create a seamless, elegant journey to purchase.',
  },
  {
    title: 'Keep your site running smoothly',
    text: 'No compromises on quality! Air360 uncover hidden UX issues so your online presence remains as polished as your brand.',
  },
  {
    title: 'Keep your customers happy',
    text: 'Help customers effortlessly discover your iconic pieces and keep them engaged. Air360 ensure your products shine in the spotlight where they belong.',
  },
];
---

<BaseLayout title={pageTitle}>
  <div class="container-custom" data-theme="dark">
    <section class="mx-auto my-32 max-w-5xl px-5 md:my-36">
      <h1
        class="font-clash-display-bold text-center text-2xl leading-tight text-slate-700 md:text-6xl"
      >
        Create the best possible <br />
        <mark class="bg-primary-500 p-1 text-white">luxury shopping</mark> experience
      </h1>

      <Testimonial />

      <Highlights highlightsList={highlightsList} />

      <section class="my-28 flex flex-col justify-center">
        <h2
          class="font-clash-display-bold mb-10 text-center text-2xl leading-tight text-slate-600 md:text-3xl"
        >
          Want to see how <mark class="bg-primary-500 p-1 text-white">easy</mark> it is?
        </h2>
        <video
          class="h-auto w-full rounded-2xl shadow-lg transition-opacity duration-300"
          autoplay
          loop
          muted
          playsinline
        >
          <source
            src="https://cdn.loom.com/sessions/thumbnails/ec06bf3738f64c8e960b2c0eccaf89b0-00001.mp4"
            type="video/mp4"
          />
          Sorry, your browser does not support embedded videos.
        </video>
      </section>

      <HighlightsSummary highlightsList={highlightsList} />
      <CallToAction />
    </section>
  </div>
</BaseLayout>
