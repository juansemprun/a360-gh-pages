---
import { Image } from 'astro:assets';

import BaseLayout from '@layouts/BaseLayout.astro';

import Testimonial from '@ui/use-cases/Testimonial.astro';
import FooterSection from '@ui/use-cases/FooterSection.astro';
import CallToAction from '@ui/use-cases/CallToAction.astro';

const pageTitle = 'E-commerce Companies';

import dataBaseImg from '@assets/images/database.webp';
---

<BaseLayout title={pageTitle}>
  <div class="container-custom" data-theme="dark">
    <section class="mx-auto my-32 max-w-5xl px-5 md:my-36">
      <h1
        class="font-clash-display-bold text-center text-2xl leading-tight text-slate-600 md:text-5xl"
      >
        Create the best possible <br />
        <mark class="bg-primary-500 p-1 text-white">online booking experience</mark>
      </h1>

      <Testimonial />

      <section class="space-y-10">
        <div>
          <h3 class="font-clash-display-bold mb-2.5 text-xl text-slate-600 md:text-2xl">
            Create experiences that <mark class="bg-primary-500 p-1 text-white">convert</mark>
          </h3>
          <p class="text-base text-slate-600 md:text-lg">
            Turn searchers into travelers by tailoring their journey. Segment customers and provide
            personalized flight experiences with Air360!
          </p>
        </div>
        <div>
          <h3 class="font-clash-display-bold mb-2.5 text-xl text-slate-600 md:text-2xl">
            The best possible version of
            <mark class="bg-primary-500 p-1 text-white">every page</mark>
          </h3>
          <p class="text-base text-slate-600 md:text-lg">
            Every click is a step closer to their destination—make it seamless. Refine every
            interaction to ensure smooth navigation and booking with Air360.
          </p>
        </div>
        <div>
          <h3 class="font-clash-display-bold mb-2.5 text-xl text-slate-600 md:text-2xl">
            <mark class="bg-primary-500 p-1 text-white">Simplify</mark> the booking experience
          </h3>
          <p class="text-base text-slate-600 md:text-lg">
            Don't let travelers abandon their plans. Air360 highlight where they hesitate, helping
            you streamline the booking process and increase ticket sales.
          </p>
        </div>
        <div>
          <h3 class="font-clash-display-bold mb-2.5 text-xl text-slate-600 md:text-2xl">
            Keep your site running <mark class="bg-primary-500 p-1 text-white">smoothly</mark>
          </h3>
          <p class="text-base text-slate-600 md:text-lg">
            No turbulence in your UX! Air360 reveal issues fast so your site delivers a flawless
            booking experience.
          </p>
        </div>
        <div>
          <h3 class="font-clash-display-bold mb-2.5 text-xl text-slate-600 md:text-2xl">
            Keep your <mark class="bg-primary-500 p-1 text-white">customers happy</mark>
          </h3>
          <p class="text-base text-slate-600 md:text-lg">
            Make it easy for travelers to find the flights and services they need. Air360 ensure
            your offerings are visible and compelling to keep bookings soaring.
          </p>
        </div>
      </section>

      <section class="my-28 flex flex-col justify-center">
        <h2
          class="font-clash-display-bold mb-10 text-center text-2xl leading-tight text-slate-600 md:text-3xl"
        >
          Want to see how <mark class="bg-primary-500 p-1 text-white">easy</mark> it is?
        </h2>
        <video
          class="h-auto w-full rounded-2xl shadow-lg transition-opacity duration-300"
          autoplay
          loop
          muted
          playsinline
        >
          <source
            src="https://cdn.loom.com/sessions/thumbnails/ec06bf3738f64c8e960b2c0eccaf89b0-00001.mp4"
            type="video/mp4"
          />
          Sorry, your browser does not support embedded videos.
        </video>
      </section>

      <CallToAction />
    </section>
  </div>
</BaseLayout>
