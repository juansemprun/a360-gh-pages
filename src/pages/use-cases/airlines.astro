---
import BaseLayout from '@layouts/BaseLayout.astro';

import CallToAction from '@ui/use-cases/CallToAction.astro';
import Highlights from '@ui/use-cases/Highlights.astro';
import HighlightsSummary from '@ui/use-cases/HighlightsSummary.astro';
import Testimonial from '@ui/use-cases/Testimonial.astro';

import { ChevronDown } from '@assets/icons';

const pageTitle = 'Gaming Companies';

const highlightsList = [
  {
    title: 'Create experiences that convert',
    text: 'Turn searchers into travelers by tailoring their journey. Segment customers and provide personalized flight experiences with Air360!',
  },
  {
    title: 'The best possible version of every page',
    text: 'Every click is a step closer to their destination—make it seamless. Refine every interaction to ensure smooth navigation and booking with Air360.',
  },
  {
    title: 'Simplify the booking experience',
    text: "Don't let travelers abandon their plans. Air360 highlight where they hesitate, helping you streamline the booking process and increase ticket sales.",
  },
  {
    title: 'Keep your site running smoothly',
    text: 'No turbulence in your UX! Air360 reveal issues fast so your site delivers a flawless booking experience.',
  },
  {
    title: 'Keep your customers happy',
    text: 'Make it easy for travelers to find the flights and services they need. Air360 ensure your offerings are visible and compelling to keep bookings soaring.',
  },
];
---

<BaseLayout title={pageTitle}>
  <div
    data-theme="light"
    class="bg-gradient-primary-darker absolute inset-0 -z-10 h-full w-full items-center px-5 py-24"
  >
  </div>
  <div class="container-custom">
    <section class="mx-auto my-32 md:my-20">
      <div class="flex h-screen flex-col items-center justify-center">
        <h1
          class="font-clash-display-bold text-center text-5xl leading-tight tracking-wide text-gray-100 md:text-7xl"
        >
          Create the best possible <br />
          <mark class="bg-primary-500 p-1 text-gray-100">online booking</mark> experience
        </h1>

        <Testimonial />

        <ChevronDown class="fill-primary-600 mt-20 animate-bounce" width="40" height="40" />
      </div>

      <Highlights highlightsList={highlightsList} />

      <section class="my-28 flex flex-col justify-center">
        <h2
          class="font-clash-display-bold mb-10 text-center text-2xl leading-tight tracking-wide text-slate-600 md:text-4xl"
        >
          Want to see how <mark class="bg-primary-500 p-1 text-white">easy</mark> it is?
        </h2>
        <video
          class="h-auto w-full rounded-2xl shadow-lg transition-opacity duration-300"
          autoplay
          loop
          muted
          playsinline
          src="https://cdn.loom.com/sessions/thumbnails/ec06bf3738f64c8e960b2c0eccaf89b0-00001.mp4"
        >
          <!-- <source
            src="https://cdn.loom.com/sessions/thumbnails/ec06bf3738f64c8e960b2c0eccaf89b0-00001.mp4"
            type="video/mp4"
          /> -->
          Sorry, your browser does not support embedded videos.
        </video>
      </section>

      <HighlightsSummary highlightsList={highlightsList} />
      <CallToAction />
    </section>
  </div>
</BaseLayout>
