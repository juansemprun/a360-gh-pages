---
import BaseLayout from '@layouts/BaseLayout.astro';

import CallToAction from '@ui/use-cases/CallToAction.astro';
import Highlights from '@ui/use-cases/Highlights.astro';
import HighlightsSummary from '@ui/use-cases/HighlightsSummary.astro';
import Testimonial from '@ui/use-cases/Testimonial.astro';

import { ChevronDown } from '@assets/icons';

const pageTitle = 'Gaming Companies';

const highlightsList = [
  {
    title: 'Create experiences that convert',
    text: 'Bring your diverse brands to life online and watch visitors become loyal fans. Segment audiences and personalize their experience with Air360!',
  },
  {
    title: 'The best possible version of every page',
    text: 'Every click reflects your brand portfolio—make every page stand out. Refine interactions to showcase the best of what you offer with Air360.',
  },
  {
    title: 'Simplify the buying experience',
    text: 'Don’t let customers struggle with too many options. Air360 reveal friction points, helping you streamline paths to purchase across all brands.',
  },
  {
    title: 'Keep your site running smoothly',
    text: 'No errors, no confusion: Air360 identify UX issues across your brands, ensuring a smooth experience for every customer.',
  },
  {
    title: 'Keep your customers happy',
    text: 'Help customers find their favorite products and services effortlessly. Air360 enhance visibility to keep engagement high across your portfolio.',
  },
];
---

<BaseLayout title={pageTitle}>
  <div
    data-theme="light"
    class="bg-gradient-primary-darker absolute inset-0 -z-10 h-full w-full items-center px-5 py-24"
  >
  </div>
  <div class="container-custom">
    <section class="mx-auto my-32 px-5 md:my-20">
      <div class="flex h-screen flex-col items-center justify-center">
        <h1
          class="font-clash-display-bold text-center text-2xl leading-tight tracking-wide text-gray-100 md:text-7xl"
        >
          Turn Multi-Brand Complexity <br />
          into <mark class="bg-primary-500 p-1 text-gray-100">Conversion Clarity</mark>
        </h1>

        <Testimonial />

        <ChevronDown class="mt-40 animate-bounce fill-pink-500" width="40" height="40" />
      </div>

      <Highlights highlightsList={highlightsList} />

      <section class="my-28 flex flex-col justify-center">
        <h2
          class="font-clash-display-bold mb-10 text-center text-2xl leading-tight tracking-wide text-slate-600 md:text-4xl"
        >
          Want to see how <mark class="bg-primary-500 p-1 text-white">easy</mark> it is?
        </h2>
        <video
          class="h-auto w-full rounded-2xl shadow-lg transition-opacity duration-300"
          autoplay
          loop
          muted
          playsinline
          src="https://cdn.loom.com/sessions/thumbnails/ec06bf3738f64c8e960b2c0eccaf89b0-00001.mp4"
        >
          <!-- <source
            src="https://cdn.loom.com/sessions/thumbnails/ec06bf3738f64c8e960b2c0eccaf89b0-00001.mp4"
            type="video/mp4"
          /> -->
          Sorry, your browser does not support embedded videos.
        </video>
      </section>

      <HighlightsSummary highlightsList={highlightsList} />
      <CallToAction />
    </section>
  </div>
</BaseLayout>
