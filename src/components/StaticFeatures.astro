---
import { TicketAirline } from '@assets/icons';

export type IconComponent = (props?: { width?: number; height?: number; class?: string }) => any;

export interface StaticFeatureItem {
  icon: IconComponent;
  title: string;
  description: string;
  content: string;
}

interface Feature {
  id: string;
  heading: string;
  description: string;
  video: string;
  url: string;
  icon: IconComponent;
  poster?: string;
  isDefault: boolean;
}

export interface StaticFeaturesProps {
  title?: string;
  description?: string;
  features?: Feature[];
  className?: string;
}

const { features = [] as Feature[] } = Astro.props as StaticFeaturesProps;
---

<div class="container-custom lg:hidden" data-theme="dark">
  <div class="my-32 flex flex-col md:my-20">
    <div class="flex flex-col">
      {
        features.map(({ heading, description, video, poster }) => (
          <div class="flex flex-col items-center p-1">
            <div class="flex flex-col items-center gap-2 px-0 py-6 text-center">
              <div class="flex items-center gap-2">
                <h3 class="text-xl font-semibold text-slate-900">{heading}</h3>
              </div>
              <p class="max-w-3xs text-center text-base font-medium leading-6 text-slate-600">
                {description}
              </p>
            </div>
            <img
              src={poster}
              alt={`${heading} - ${description}`}
              class="aspect-video h-auto w-full rounded-2xl object-cover shadow-lg ring ring-black/5"
            />
          </div>
        ))
      }
    </div>
  </div>
</div>
