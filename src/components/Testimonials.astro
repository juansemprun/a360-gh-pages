---
import { TestimonialsCarousel } from '@/components/react/TestimonialsCarousel';

interface Testimonial {
  id: number;
  name: string;
  client: string;
  body: string;
  img: string;
}

interface TestimonialsData {
  heading: {
    line1: string;
    line2: string;
  };
  subheading: string;
  subheading2: string;
  ctaText: string;
  ctaUrl: string;
  items: Testimonial[];
}

interface Props {
  testimonials: TestimonialsData;
}

const { testimonials } = Astro.props;
---

<section
  class="container-custom w-full pb-32"
  data-theme="dark"
  aria-labelledby="testimonials-heading"
>
  <div class="flex flex-col items-center gap-6">
    <h2
      id="testimonials-heading"
      class="font-clash-display-bold mb-2 text-center text-2xl text-slate-700 lg:text-5xl"
    >
      <span class="block">{testimonials.heading.line1}</span>
      <span class="block">
        {testimonials.heading.line2}
      </span>
    </h2>

    <p class="text-muted-foreground text-center lg:text-lg">
      <span>{testimonials.subheading}</span>
      <span>{testimonials.subheading2}</span>
    </p>

    <div
      class="animate-rotate-border glow-border relative mt-5 w-80 max-w-sm cursor-pointer rounded-xl p-[4px] transition-all duration-500 ease-out hover:scale-[1.03]"
    >
      <a
        href={testimonials.ctaUrl}
        class="block rounded-lg border bg-white px-4 py-4 text-center text-lg text-slate-700"
      >
        <span class="text-lg font-semibold">{testimonials.ctaText}</span>
      </a>
    </div>
  </div>

  <TestimonialsCarousel testimonials={testimonials.items} client:visible />
</section>
