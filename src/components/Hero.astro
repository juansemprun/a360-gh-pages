---
// Hero Section Component - Main landing section with gradient background
const videoUrl =
  'https://www.loom.com/embed/ec06bf3738f64c8e960b2c0eccaf89b0?sid=cb91bf0c-e504-4098-91d4-c7afbbb919dc?hide_owner=true&hide_share=true&hide_title=true&hideEmbedTopBar=true';
---

<section class="bg-gradient-primary relative min-h-screen w-full overflow-hidden">
  <!-- Background textures and gradients -->
  <div class="absolute inset-0">
    <div class="absolute h-full w-full opacity-30">
      <!-- Noise texture overlays for visual depth -->
      <div
        class="absolute left-[380px] top-[849px] h-[1123px] w-[1140px] -rotate-12 bg-[url('/noise-play---ycl0qmtldn4ajk5nsm3tfjvxujq-webp.png')] bg-cover bg-center"
      >
      </div>
      <div
        class="absolute left-[832px] top-[-529px] h-[1331px] w-[1317px] rotate-[-56deg] bg-[url('/noise-t---hmp0xbcr9iuweonyo7eawoafp7q-webp.png')] bg-cover bg-center"
      >
      </div>
    </div>
  </div>

  <!-- Main content container -->
  <div class="container-custom relative z-10 py-20 lg:py-32">
    <!-- Hero text and CTA section -->
    <div class="mb-16 text-center lg:mb-24">
      <div class="mb-8">
        <!-- <h1 class="gradient-text animate-fade-in mb-4 text-7xl font-normal">Record</h1> -->
        <!-- <h1 class="gradient-text animate-fade-in text-7xl font-normal">incredible videos</h1> -->
        <h1 class="gradient-text animate-fade-in font-clash-display-bold text-8xl font-normal">
          <span class="block">CRO that clicks,</span>
          <span class="block">literally</span>
        </h1>
      </div>

      <p class="animate-slide-up mb-12 text-2xl font-medium text-white">
        Air360 is the conversion whisperer that decodes your users for you
      </p>

      <!-- <button
        class="btn-primary animate-slide-up mb-6 h-14 w-80"
        aria-label="Get started with Air360"
      >
        Get started
      </button> -->

      <!-- <p class="text-xs font-medium text-white opacity-50">
        7-day Free trial — no credit card required
      </p> -->
    </div>

    <!-- Video section with tabs -->
    <div class="relative mb-16">
      <!-- Tab navigation -->
      <!-- <div class="mb-8 flex justify-center">
        <div class="flex rounded-full bg-white/10 p-1" role="tablist" aria-label="Video categories">
          <button
            class="rounded-full px-6 py-2 text-base font-normal text-white/50 transition-all duration-200 hover:text-white"
            role="tab"
            aria-selected="false"
          >
            Demos
          </button>
          <button
            class="rounded-full px-6 py-2 text-base font-normal text-white/50 transition-all duration-200 hover:text-white"
            role="tab"
            aria-selected="false"
          >
            Tutorials
          </button>
          <button
            class="rounded-full bg-white/20 px-6 py-2 text-base font-normal text-white transition-all duration-200"
            role="tab"
            aria-selected="true"
          >
            Courses
          </button>
        </div>
      </div> -->

      <!-- Video placeholder -->
      <div class="relative mx-auto max-w-5xl">
        <!-- <img
          class="h-auto w-full rounded-2xl shadow-2xl"
          alt="Video preview showing Air360 interface with course creation features"
          src="/overlay-shadow.svg"
        /> -->
        <video class="h-auto w-full rounded-2xl shadow-2xl" autoplay loop playsinline muted>
          <source
            src="https://cdn.loom.com/sessions/thumbnails/ec06bf3738f64c8e960b2c0eccaf89b0-00001.mp4"
            type="video/mp4"
          />
          Sorry, your browser does not support embedded videos.
        </video>
      </div>
    </div>

    <!-- Demo video card -->
    <div class="mb-16 flex justify-center">
      <div
        class="card w-full max-w-2xl rotate-1 transform border border-white/20 bg-white/10 p-6 backdrop-blur-sm"
      >
        <div class="flex items-center gap-6">
          <div class="flex-shrink-0">
            <iframe
              src={videoUrl}
              allow="autoplay; clipboard-write"
              title="Loom video"
              allowfullscreen
              loading="lazy"
              class="h-28 w-48 -rotate-1 rounded-lg"
            >
            </iframe>
          </div>
          <div class="flex-1">
            <h3 class="mb-2 text-2xl font-normal text-white">
              Got a Minute? That's All You Need to know Air360
            </h3>
            <!-- <h3 class="mb-4 text-2xl font-normal text-white">60 Seconds! ⚡</h3> -->
            <p class="text-xl font-medium text-white/70">Watch the video!</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer section with customer logos -->

    <div class="text-center">
      <div class="container">
        <img src="https://assets.codepen.io/1480814/image_2.png" />
        <img src="https://assets.codepen.io/1480814/image_3.png" />
        <img src="https://assets.codepen.io/1480814/image_4.png" />
        <img src="https://assets.codepen.io/1480814/image_5.png" />
        <img src="https://assets.codepen.io/1480814/image_6.png" />
        <img src="https://assets.codepen.io/1480814/image_7.png" />
        <img src="https://assets.codepen.io/1480814/image_2.png" />
        <img src="https://assets.codepen.io/1480814/image_7.png" />
        <img src="https://assets.codepen.io/1480814/image_3.png" />
      </div>
    </div>
  </div>

  <!-- Bottom gradient line -->
  <div
    class="via-magenta-400 absolute bottom-0 h-0.5 w-full bg-gradient-to-r from-yellow-400 via-cyan-400 to-yellow-400 shadow-lg"
  >
  </div>

  <style>
    .container {
      --s: 25px; /* size of the logo */
      --d: 20s; /* animation duration*/
      --n: 6; /* number of visible logos */

      display: flex;
      overflow: hidden;
    }

    img {
      width: var(--s);
      offset: shape(
        from calc(var(--s) / -2) 50%,
        hline by calc(sibling-count() * max(100% / var(--n), var(--s) + 10px))
      );
      animation: x var(--d) linear infinite calc(-1 * sibling-index() * var(--d) / sibling-count());
    }
    @keyframes x {
      to {
        offset-distance: 100%;
      }
    }

    /* extra styles */
    .container {
      padding-block: 5px;
      margin: 15px auto;
      max-width: 450px;
      mask-image: linear-gradient(
        to right,
        rgba(0, 0, 0, 0) 0%,
        rgb(0, 0, 0) 10%,
        rgb(0, 0, 0) 90%,
        rgba(0, 0, 0, 0) 100%
      );
    }
    :nth-child(1 of .container) img {
      animation-direction: reverse;
    }
    body {
      background: #ffefd5;
    }
  </style>
</section>
