---
import FeatureCardsCarousel from '@components/react/FeatureCardsCarousel';

interface Feature {
  id: string;
  icon?: any;
  heading: string;
  description: string;
  video: string;
  poster?: string;
  url: string;
  isDefault: boolean;
}

interface Props {
  features?: Feature[];
}

const { features = [] as Feature[] } = Astro.props as Props;

// Serialize features for the React component (convert icon components to strings)
const serializedFeatures = features?.map((feature) => ({
  ...feature,
  iconName: feature.icon || 'Lightbulb', // Extract icon name
}));
---

<section class="container-custom hidden py-32 lg:block" data-theme="dark">
  <!-- <div class="container-custom"> -->
  <FeatureCardsCarousel features={serializedFeatures} client:load />
  <!-- </div> -->
</section>
