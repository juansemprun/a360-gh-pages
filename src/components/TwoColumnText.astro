---
import { Image } from 'astro:assets';

import signature from '@assets/images/signature.webp';

interface TwoColumnTextProps {
  titleFirstLine: string;
  titleSecondLine: string;
}

const { titleFirstLine, titleSecondLine } = Astro.props as TwoColumnTextProps;
---

<div class="container-custom">
  <section class="lg:px-8; mx-auto max-w-7xl px-4 sm:px-6" data-theme="dark">
    <header class="mb-20 text-center">
      <h2 class="font-clash-display-bold text-3xl text-slate-700 md:text-5xl">
        <span class="block">{titleFirstLine}</span>
        <span class="mt-5 block">{titleSecondLine}</span>
      </h2>
    </header>
    <article class="flex flex-col gap-8 lg:flex-row lg:items-start">
      <div class="prose prose-base md:prose-2xl grid flex-1 content-start">
        <slot name="left" class="prose" />
      </div>
      <div class="prose prose-base md:prose-2xl grid flex-1 content-start">
        <slot name="right" />

        <Image src={signature} alt="Signature of Air360 CEO" class="!m-0 h-16 w-auto p-2" />
      </div>
    </article>
  </section>
</div>
