---
import Marquee from '@components/Marquee.astro';
import DynamicFeatures from '@components/DynamicFeatures.astro';

// Hero Section Component - Main landing section with gradient background
const videoUrl =
  'https://www.loom.com/embed/ec06bf3738f64c8e960b2c0eccaf89b0?sid=cb91bf0c-e504-4098-91d4-c7afbbb919dc&hide_owner=true&hide_share=true&hide_title=true&hideEmbedTopBar=true';
---

<section
  class="bg-gradient-primary-darker min-h-screen w-full overflow-hidden py-16"
  data-theme="light"
>
  <!-- noise -->
  <div
    class="absolute left-0 z-0 flex h-screen w-full flex-col justify-center gap-5 overflow-hidden"
  >
    <div
      class="absolute left-0 top-[-529px] z-10 h-[1331px] w-[1317px] rotate-[-56deg] bg-[url('/noise-t---hmp0xbcr9iuweonyo7eawoafp7q-webp.png')] bg-cover bg-center"
    >
    </div>
  </div>
  <!-- Main content container -->
  <div class="container-custom relative z-10 flex flex-col items-center gap-6 py-20 lg:py-32">
    <!-- Hero text and CTA section -->
    <div class="title-container">
      <div>
        <h1 class="font-clash-display-bold text-center text-6xl lg:text-8xl">
          <span class="gradient-text block">CRO that clicks,</span>
          <span class="gradient-text block">literally</span>
        </h1>
      </div>

      <h2 class="subtitle !font-inter text-2xl !font-medium lg:text-3xl">
        Air360 is the conversion whisperer that decodes your users for you
      </h2>

      <a
        href="/"
        class="cta animate-slide-up inline-flex items-center justify-center rounded-xl bg-[#222223] px-8 py-4 text-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2"
      >
        <span class="text-lg font-semibold text-white">Get started</span>
      </a>
      <p class="text-xs font-bold text-white/50">7-day Free trial — no credit card required</p>
    </div>

    <div class="mx-auto mb-16 max-w-5xl">
      <DynamicFeatures cardType="tabs" layout="image-bottom" className="bg-transparent" />
    </div>

    <!-- Demo video card -->
    <div class="mb-16 flex justify-center">
      <div
        class="card w-full max-w-2xl rotate-1 transform cursor-pointer border border-white/20 bg-transparent p-6 backdrop-blur-sm hover:rotate-0 hover:bg-white/10"
      >
        <div class="flex items-center gap-6">
          <div class="flex-shrink-0">
            <iframe
              src={videoUrl}
              allow="autoplay; clipboard-write"
              title="Loom video"
              allowfullscreen
              loading="lazy"
              class="h-28 w-48 -rotate-1 rounded-lg"
            >
            </iframe>
          </div>
          <div class="flex-1">
            <h3 class="mb-2 text-2xl font-normal text-white">
              Got a Minute? That's All You Need to know Air360
            </h3>
            <!-- <h3 class="mb-4 text-2xl font-normal text-white">60 Seconds! ⚡</h3> -->
            <p class="text-xl font-medium text-white/60">Watch the video!</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer section with customer logos -->
    <p class="text-xs font-bold text-white/50">7-day Free trial — no credit card required</p>
    <Marquee />
  </div>
</section>
<!-- Bottom gradient line -->
<div
  class="bottom-0 h-0.5 w-full bg-gradient-to-r from-[#F771BF] via-[#f04d66] to-[#fd7043] shadow-lg"
>
</div>

<style is:global>
  .subtitle {
    font-family: var(--font-inter) !important;
    font-weight: 500;
    font-size: 28px;
    line-height: 42px;
    color: white;
    margin-bottom: 24px;
  }

  .title-container {
    align-items: center;
    display: flex;
    flex: none;
    flex-direction: column;
    flex-wrap: nowrap;
    gap: 24px;
    height: min-content;
    justify-content: center;
    /* max-width: 800px; */
    padding: 0;
    position: relative;
    width: 100%;
    text-align: center;
  }

  .cta {
    width: 320px;
    box-shadow:
      rgba(0, 0, 0, 0.08) 0px 0px 1px 1px,
      rgba(0, 0, 0, 0.16) 0px 2px 4px 0px,
      rgba(0, 0, 0, 0) 0px 4px 8px 0px,
      rgba(0, 0, 0, 0) 0px 16px 16px 0px,
      rgba(255, 255, 255, 0.25) 0px 1px 1px 0px inset;
  }

  .cta:hover {
    box-shadow:
      rgba(0, 0, 0, 0.08) 0px 0px 1px 1px,
      rgba(0, 0, 0, 0.16) 0px 2px 4px 0px,
      rgba(0, 0, 0, 0) 0px 4px 8px 0px,
      rgba(0, 0, 0, 0.12) 0px 16px 16px 0px,
      rgba(255, 255, 255, 0.25) 0px 1px 1px 0px inset;
  }
</style>
