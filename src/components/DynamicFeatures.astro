---
// Dynamic Feature Section Component - Modular component with flexible layout and styling
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  content: string; // Image path or text content
}

export interface Props {
  title?: string;
  description?: string;
  features?: [FeatureItem, FeatureItem, FeatureItem]; // Exactly 3 features
  cardType?: 'tabs' | 'cards';
  layout?: 'image-top' | 'image-bottom' | 'image-left' | 'image-right';
  contentType?: 'image' | 'text' | 'video'; // Type of content to display (image, text, or video)
  className?: string;
}

const {
  title = '',
  description = '',
  features = [
    {
      icon: 'svg-8.svg',
      title: 'Feature One',
      description: 'lorepsum dolor sit amet, consectetur adipiscing elit.',
      content:
        'https://cdn.loom.com/sessions/thumbnails/ec06bf3738f64c8e960b2c0eccaf89b0-00001.mp4',
    },
    {
      icon: 'svg-8.svg',
      title: 'Feature Two',
      description: 'lorepsum dolor sit amet, consectetur adipiscing elit.',
      content:
        'https://cdn.loom.com/sessions/thumbnails/ec06bf3738f64c8e960b2c0eccaf89b0-00001.mp4',
    },
    {
      icon: 'svg-4.svg',
      title: 'Feature Three',
      description: 'lorepsum dolor sit amet, consectetur adipiscing elit.',
      content:
        'https://cdn.loom.com/sessions/thumbnails/ec06bf3738f64c8e960b2c0eccaf89b0-00001.mp4',
    },
  ],
  cardType = 'cards',
  layout = 'image-top',
  contentType = 'video',
  className = '',
} = Astro.props;

// maybe I need to add de src for the videos/images in the interface?

// Generate unique IDs for this component instance
const componentId = `dynamic-feature-${Math.random().toString(36).substr(2, 9)}`;
const imageId = `${componentId}-image`;
const textId = `${componentId}-text`;
---

<section class={`w-full bg-white ${className} max-w-5xl mx-auto`}>
  <div class="container-custom">
    <!-- Header Section -->
    <div class="mb-16 text-center lg:mb-20">
      {title ? <h2 class="mb-6 text-5xl font-normal text-slate-900">{title}</h2> : ''}
      {description ? <p class="text-3xl font-medium text-slate-600">{description}</p> : ''}
    </div>
  </div>

  <!-- Dynamic Layout Container -->
  <div
    class={`
      ${
        layout === 'image-left' || layout === 'image-right'
          ? 'flex flex-col lg:flex-row items-center gap-12 lg:gap-16'
          : 'flex flex-col gap-10'
      }
      ${layout === 'image-right' ? 'lg:flex-row-reverse' : ''}
    `}
  >
    <!-- Dynamic Content Display -->
    <div
      class={`
        ${layout === 'image-left' || layout === 'image-right' ? 'w-full lg:w-2/3' : 'w-full'}
        ${layout === 'image-bottom' ? 'order-2' : ''}
      `}
    >
      {
        contentType === 'image' ? (
          <img
            id={imageId}
            class="h-auto w-full rounded-2xl shadow-lg transition-opacity duration-300"
            alt="Dynamic feature content"
            src={features[0].content}
            data-component-id={componentId}
          />
        ) : contentType === 'video' ? (
          <video
            id={`${componentId}-video`}
            class="h-auto w-full rounded-2xl shadow-lg transition-opacity duration-300"
            autoplay
            loop
            muted
            playsinline
            data-component-id={componentId}
          >
            <source src={features[0].content} type="video/mp4" />
            Sorry, your browser does not support embedded videos.
          </video>
        ) : (
          <div
            id={textId}
            class="w-full rounded-2xl border border-slate-200 bg-slate-50 p-8 transition-opacity duration-300"
            data-component-id={componentId}
          >
            <div class="text-lg font-medium leading-relaxed text-slate-700">
              {features[0].content}
            </div>
          </div>
        )
      }
    </div>

    <!-- Feature Cards/Tabs -->
    <div
      class={`
        ${layout === 'image-left' || layout === 'image-right' ? 'w-full lg:w-1/3' : 'w-full'}
        ${layout === 'image-bottom' ? 'order-1' : ''}
      `}
    >
      {
        cardType === 'tabs' ? (
          <div class="flex justify-center">
            <div role="tablist" aria-label="Feature categories">
              {features.map((feature, index) => (
                <button
                  class={`cursor-pointer rounded-full px-6 py-2 text-base font-normal text-black/50 transition-all duration-200 hover:text-black`}
                  role="tab"
                  aria-selected={index === 0 ? 'true' : 'false'}
                  data-feature-index={index}
                  data-component-id={componentId}
                  data-feature-content={feature.content}
                >
                  {feature.title}
                </button>
              ))}
            </div>
          </div>
        ) : (
          <div
            class={` ${
              layout === 'image-left' || layout === 'image-right'
                ? 'flex flex-col gap-6'
                : 'grid grid-cols-1 gap-8 md:grid-cols-3 lg:gap-10'
            } `}
          >
            {features.map((feature, index) => (
              <article
                class={`cursor-pointer rounded-3xl border-0 bg-white p-8 shadow-lg transition-all duration-300 ${index === 0 ? 'bg-slate-50 opacity-100' : 'opacity-75 hover:opacity-100'} `}
                data-feature-index={index}
                data-component-id={componentId}
                data-feature-content={feature.content}
              >
                <header class="mb-6 flex items-center">
                  <img class="h-6 w-6 flex-shrink-0" alt="" src={feature.icon} />
                  <h3 class="ml-3 text-xl font-normal text-slate-900">{feature.title}</h3>
                </header>
                <p class="text-base font-medium leading-6 text-slate-600">{feature.description}</p>
                {index === 0 && (
                  <div class="mt-5" aria-label="Currently active feature">
                    <img class="h-1 w-11" alt="Active indicator" src="/loader.svg" />
                  </div>
                )}
              </article>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  @reference "../styles/global.css";
  /* Tab specific styles - these require attribute selectors that can't be done with utility classes */
  [role='tab'][aria-selected='true'] {
    @apply bg-white text-black;
  }

  /* [role='tab'][aria-selected='false'] {
    @apply text-[var(--color-primary-500)];
  } */

  /* [role='tab']:hover {
    @apply text-[var(--color-primary-600)];
  } */

  /* Active indicator for cards */
  .active-indicator {
    @apply mt-5;
  }

  /* Smooth transitions */
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const componentInstances = new Set();

    // Find all feature buttons/cards and group by component instance
    const featureElements = document.querySelectorAll('[data-component-id][data-feature-index]');

    featureElements.forEach((element) => {
      const componentId = element.getAttribute('data-component-id');
      componentInstances.add(componentId);
    });

    // Initialize each component instance
    componentInstances.forEach((componentId) => {
      initializeComponent(componentId);
    });

    function initializeComponent(componentId) {
      const featureButtons = document.querySelectorAll(
        `[data-component-id="${componentId}"][data-feature-index]`,
      );
      const dynamicImage = document.getElementById(`${componentId}-image`);
      const dynamicText = document.getElementById(`${componentId}-text`);
      const dynamicVideo = document.getElementById(`${componentId}-video`);

      if (featureButtons.length === 0) return;

      featureButtons.forEach((button, index) => {
        button.addEventListener('click', function () {
          const featureIndex = parseInt(this.getAttribute('data-feature-index'));
          const featureContent = this.getAttribute('data-feature-content');

          // Update active states
          updateActiveStates(componentId, featureIndex);

          // Update dynamic content
          updateDynamicContent(dynamicImage, dynamicText, dynamicVideo, featureContent);
        });
      });
    }

    function updateActiveStates(componentId, activeIndex) {
      const featureButtons = document.querySelectorAll(
        `[data-component-id="${componentId}"][data-feature-index]`,
      );

      featureButtons.forEach((button, index) => {
        const isActive = index === activeIndex;

        // Handle tab styles
        if (button.getAttribute('role') === 'tab') {
          button.setAttribute('aria-selected', isActive.toString());
          if (isActive) {
            button.classList.add('bg-white', 'shadow-sm');
            // button.classList.remove('text-primary-500');
          } else {
            button.classList.remove('bg-white', 'shadow-sm');
            // button.classList.add('text-primary-500');
          }
        }

        // Handle card styles
        if (!button.getAttribute('role')) {
          // This is a card, not a tab
          if (isActive) {
            button.classList.add('bg-slate-50', 'opacity-100');
            button.classList.remove('opacity-75');

            // Add active indicator
            const existingIndicator = button.querySelector(
              '[aria-label="Currently active feature"]',
            );
            if (!existingIndicator) {
              const indicator = document.createElement('div');
              indicator.className = 'mt-5';
              indicator.setAttribute('aria-label', 'Currently active feature');
              indicator.innerHTML =
                '<img class="w-11 h-1" alt="Active indicator" src="/loader.svg" />';
              button.appendChild(indicator);
            }
          } else {
            button.classList.remove('bg-slate-50', 'opacity-100');
            button.classList.add('opacity-75');

            // Remove active indicator
            const indicator = button.querySelector('[aria-label="Currently active feature"]');
            if (indicator) {
              indicator.remove();
            }
          }
        }
      });
    }

    function updateDynamicContent(imageElement, textElement, videoElement, content) {
      if (imageElement) {
        // Handle image content
        imageElement.style.opacity = '0';
        setTimeout(() => {
          imageElement.src = content;
          imageElement.style.opacity = '1';
        }, 150);
      }

      if (videoElement) {
        // Handle video content
        videoElement.style.opacity = '0';
        setTimeout(() => {
          videoElement.src = content;
          videoElement.load();
          videoElement.style.opacity = '1';
        }, 150);
      }

      if (textElement) {
        // Handle text content
        const textContainer = textElement.querySelector('div');
        if (textContainer) {
          textElement.style.opacity = '0';
          setTimeout(() => {
            textContainer.textContent = content;
            textElement.style.opacity = '1';
          }, 150);
        }
      }
    }
  });
</script>
