---
// Dynamic Feature Section Component - Modular component with flexible layout and styling
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  content: string; // Image path or text content
}

export interface Props {
  title?: string;
  description?: string;
  features?: [FeatureItem, FeatureItem, FeatureItem]; // Exactly 3 features
  cardType?: 'tabs' | 'cards';
  layout?: 'image-top' | 'image-bottom' | 'image-left' | 'image-right';
  contentType?: 'image' | 'text' | 'video'; // Type of content to display (image, text, or video)
  className?: string;
  dataTheme?: 'dark' | 'light';
  gradient?: string;
}

const {
  title = '',
  description = '',
  features = [
    {
      icon: '/website/svg-8.svg',
      title: 'Demo',
      description: 'lorepsum dolor sit amet, consectetur adipiscing elit.',
      content:
        'https://cdn.loom.com/sessions/thumbnails/ec06bf3738f64c8e960b2c0eccaf89b0-00001.mp4',
    },
    {
      icon: '/website/svg-8.svg',
      title: 'Turorials',
      description: 'lorepsum dolor sit amet, consectetur adipiscing elit.',
      content:
        'https://cdn.loom.com/sessions/thumbnails/ec06bf3738f64c8e960b2c0eccaf89b0-00001.mp4',
    },
    {
      icon: '/website/svg-4.svg',
      title: 'Courses',
      description: 'lorepsum dolor sit amet, consectetur adipiscing elit.',
      content:
        'https://cdn.loom.com/sessions/thumbnails/ec06bf3738f64c8e960b2c0eccaf89b0-00001.mp4',
    },
  ],
  cardType = 'cards',
  layout = 'image-top',
  contentType = 'video',
  className = '',
  dataTheme = '',
  gradient = 'from-blue-500 to-indigo-600',
} = Astro.props;

// maybe I need to add de src for the videos/images in the interface?

// Generate unique IDs for this component instance
const componentId = `dynamic-feature-${Math.random().toString(36).substr(2, 9)}`;
const imageId = `${componentId}-image`;
const textId = `${componentId}-text`;
---

<div class="container-custom">
  <section class={`${className}`} data-theme={dataTheme}>
    <!-- Header Section -->
    <div class="mb-16 text-center lg:mb-20">
      {
        title ? (
          <h2 class="font-clash-display-bold mb-6 text-5xl text-black md:text-6xl">{title}</h2>
        ) : (
          ''
        )
      }
      {description ? <p class="text-2xl font-medium text-slate-600">{description}</p> : ''}
    </div>

    <!-- Dynamic Layout Container -->
    <div
      class={`
      ${
        layout === 'image-left' || layout === 'image-right'
          ? 'flex flex-col lg:flex-row items-center gap-12 lg:gap-16'
          : 'flex flex-col gap-10'
      }
      ${layout === 'image-right' ? 'lg:flex-row-reverse' : ''}
    `}
    >
      <!-- Dynamic Content Display -->
      <div
        class={`
        ${layout === 'image-left' || layout === 'image-right' ? 'w-full lg:w-2/3' : 'w-full'}
        ${layout === 'image-bottom' ? 'order-2' : ''}
      `}
      >
        {
          contentType === 'image' ? (
            <img
              id={imageId}
              class="h-auto w-full rounded-2xl shadow-lg transition-opacity duration-300"
              alt="Dynamic feature content"
              src={features[0].content}
              data-component-id={componentId}
            />
          ) : (
            <video
              id={`${componentId}-video`}
              class="h-auto w-full rounded-2xl shadow-lg transition-opacity duration-300"
              autoplay
              loop
              muted
              playsinline
              data-component-id={componentId}
            >
              <source src={features[0].content} type="video/mp4" />
              Sorry, your browser does not support embedded videos.
            </video>
          )
        }
      </div>

      <!-- Feature Cards/Tabs -->
      <div
        class={`
        ${layout === 'image-left' || layout === 'image-right' ? 'w-full lg:w-1/3' : 'w-full'}
        ${layout === 'image-bottom' ? 'order-1' : ''}
      `}
      >
        {
          cardType === 'tabs' ? (
            <div class="flex justify-center">
              <div
                role="tablist"
                aria-label="Feature categories"
                class="flex justify-between md:w-[360px]"
              >
                {features.map((feature, index) => (
                  <button
                    class={`tab cursor-pointer rounded-full px-4 py-1 text-sm font-semibold text-white/50 transition-all duration-200 hover:text-white md:text-base`}
                    role="tab"
                    aria-selected={index === 0 ? 'true' : 'false'}
                    data-feature-index={index}
                    data-component-id={componentId}
                    data-feature-content={feature.content}
                  >
                    {feature.title}
                  </button>
                ))}
              </div>
            </div>
          ) : (
            <div
              class={` ${
                layout === 'image-left' || layout === 'image-right'
                  ? 'flex flex-col gap-6'
                  : 'grid grid-cols-1 gap-8 md:grid-cols-3 lg:gap-10'
              } `}
            >
              {features.map((feature, index) => (
                <article
                  class={`cursor-pointer rounded-3xl border-0 p-8 transition-all duration-300 ${index === 0 ? 'bg-slate-50 opacity-100' : 'opacity-50 hover:opacity-100'} `}
                  data-feature-index={index}
                  data-component-id={componentId}
                  data-feature-content={feature.content}
                >
                  <header class="mb-6 flex items-center">
                    <img class="h-6 w-6 flex-shrink-0" alt="" src={feature.icon} />
                    <h3 class="ml-3 text-xl font-normal text-slate-900">{feature.title}</h3>
                  </header>
                  <p class="text-base font-medium leading-6 text-slate-600">
                    {feature.description}
                  </p>
                </article>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </section>
</div>

<style>
  @reference "../styles/global.css";
  /* Tab specific styles - these require attribute selectors that can't be done with utility classes */
  [role='tab'][aria-selected='true'] {
    @apply bg-white/20 text-white;
  }

  /* [role='tab'][aria-selected='false'] {
    @apply text-[var(--color-primary-500)];
  } */

  /* [role='tab']:hover {
    @apply text-[var(--color-primary-600)];
  } */

  /* Active indicator for cards */
  .active-indicator {
    @apply mt-5;
  }

  /* Smooth transitions */
  .tab {
    -webkit-font-smoothing: inherit;
    box-sizing: border-box;
    border-width: 0;
    border-style: solid;
    border-color: #e5e7eb;
    /* background-color: rgba(255, 255, 255, 0.15) !important; */
    opacity: 1;
  }
</style>

<script>
  document.addEventListener('astro:page-load', function () {
    const componentInstances = new Set();
    const activeIndexMap = new Map();
    const intervalMap = new Map();
    const ROTATE_INTERVAL = 5000; // 5 seconds

    // --- Core Rotation Functions ---

    function startAutoRotate(componentId) {
      if (intervalMap.has(componentId)) return; // Rotation is already running

      const featureButtons = document.querySelectorAll(
        `[data-component-id="${componentId}"][data-feature-index]`,
      );
      const count = featureButtons.length;
      if (count <= 1) return;

      const dynamicImage = document.getElementById(`${componentId}-image`);
      const dynamicText = document.getElementById(`${componentId}-text`);
      const dynamicVideo = document.getElementById(`${componentId}-video`);

      const intervalId = setInterval(() => {
        const currentIndex = activeIndexMap.get(componentId) || 0;
        const nextIndex = (currentIndex + 1) % count;

        const nextButton = document.querySelector(
          `[data-component-id="${componentId}"][data-feature-index="${nextIndex}"]`,
        );
        if (!nextButton) return;

        const nextContent = nextButton.getAttribute('data-feature-content');

        // Update state and UI directly
        activeIndexMap.set(componentId, nextIndex);
        updateActiveStates(componentId, nextIndex);
        updateDynamicContent(dynamicImage, dynamicText, dynamicVideo, nextContent);
      }, ROTATE_INTERVAL);

      intervalMap.set(componentId, intervalId);
    }

    function stopAutoRotate(componentId) {
      if (intervalMap.has(componentId)) {
        clearInterval(intervalMap.get(componentId));
        intervalMap.delete(componentId);
      }
    }

    function restartAutoRotate(componentId) {
      stopAutoRotate(componentId);
      startAutoRotate(componentId);
    }

    // --- UI Update Functions ---

    function updateActiveStates(componentId, activeIndex) {
      const featureButtons = document.querySelectorAll(
        `[data-component-id="${componentId}"][data-feature-index]`,
      );

      featureButtons.forEach((button) => {
        const buttonIndexStr = button.getAttribute('data-feature-index');
        const buttonIndex = buttonIndexStr ? parseInt(buttonIndexStr, 10) : -1;
        const isActive = buttonIndex === activeIndex;

        // Handle tab styles
        if (button.getAttribute('role') === 'tab') {
          button.setAttribute('aria-selected', isActive.toString());
          if (isActive) {
            button.classList.add('bg-white', 'shadow-sm');
          } else {
            button.classList.remove('bg-white', 'shadow-sm');
          }
        }

        // Handle card styles
        if (!button.getAttribute('role')) {
          if (isActive) {
            button.classList.add('bg-slate-50', 'opacity-100');
            button.classList.remove('opacity-50', 'hover:opacity-100');

            const existingIndicator = button.querySelector(
              '[aria-label="Currently active feature"]',
            );
            if (!existingIndicator) {
              const indicator = document.createElement('div');
              indicator.className = 'mt-5';
              indicator.setAttribute('aria-label', 'Currently active feature');
            }
          } else {
            button.classList.remove('bg-slate-50', 'opacity-100');
            button.classList.add('opacity-50', 'hover:opacity-100');

            const indicator = button.querySelector('[aria-label="Currently active feature"]');
            if (indicator) {
              indicator.remove();
            }
          }
        }
      });
    }

    function updateDynamicContent(imageElement, textElement, videoElement, content) {
      if (imageElement) {
        imageElement.style.opacity = '0';
        setTimeout(() => {
          imageElement.src = content;
          imageElement.style.opacity = '1';
        }, 150);
      }

      if (videoElement) {
        videoElement.style.opacity = '0';
        setTimeout(() => {
          const source = videoElement.querySelector('source');
          if (source) {
            source.src = content;
          } else {
            videoElement.src = content;
          }
          videoElement.load();
          videoElement.style.opacity = '1';
        }, 150);
      }

      if (textElement) {
        const textContainer = textElement.querySelector('div');
        if (textContainer) {
          textElement.style.opacity = '0';
          setTimeout(() => {
            textContainer.textContent = content;
            textElement.style.opacity = '1';
          }, 150);
        }
      }
    }

    // --- Initialization ---

    function initializeComponent(componentId) {
      const featureButtons = document.querySelectorAll(
        `[data-component-id="${componentId}"][data-feature-index]`,
      );
      const dynamicImage = document.getElementById(`${componentId}-image`);
      const dynamicText = document.getElementById(`${componentId}-text`);
      const dynamicVideo = document.getElementById(`${componentId}-video`);

      if (featureButtons.length === 0) return;

      activeIndexMap.set(componentId, 0);

      // Handle manual clicks
      featureButtons.forEach((button) => {
        button.addEventListener('click', function () {
          const featureIndexStr = this.getAttribute('data-feature-index');
          if (featureIndexStr === null) return;

          const featureIndex = parseInt(featureIndexStr, 10);
          const featureContent = this.getAttribute('data-feature-content');

          activeIndexMap.set(componentId, featureIndex);
          updateActiveStates(componentId, featureIndex);
          updateDynamicContent(dynamicImage, dynamicText, dynamicVideo, featureContent);
          restartAutoRotate(componentId);
        });
      });

      // Handle hover
      const componentSection = document
        .querySelector(`[data-component-id="${componentId}"]`)
        ?.closest('section');
      if (componentSection) {
        componentSection.addEventListener('mouseenter', () => stopAutoRotate(componentId));
        componentSection.addEventListener('mouseleave', () => startAutoRotate(componentId));
      }

      // Initial start
      startAutoRotate(componentId);
    }

    // Find all component instances on the page and initialize them
    const featureElements = document.querySelectorAll('[data-component-id][data-feature-index]');
    featureElements.forEach((element) => {
      const componentId = element.getAttribute('data-component-id');
      if (componentId) {
        componentInstances.add(componentId);
      }
    });

    componentInstances.forEach((componentId) => {
      initializeComponent(componentId);
    });

    // Clean up intervals when the user navigates away
    window.addEventListener('beforeunload', () => {
      intervalMap.forEach((_, componentId) => stopAutoRotate(componentId));
    });
  });
</script>
