---
interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<section class="max-w-7xl pt-24 text-center md:pt-32">
  <h1 class="font-clash-display-bold mb-8 text-4xl leading-tight text-slate-800 md:text-6xl">
    <Fragment set:html={title} />
  </h1>
  <p class="mx-auto max-w-3xl text-lg text-slate-500 md:text-2xl">
    {subtitle}
  </p>
</section>
