---
import { Image } from 'astro:assets';
import dataBaseImg from '@/assets/images/database.webp';

interface Props {
  title: string;
  subtitle: string;
  description: string;
}

const { title, subtitle, description } = Astro.props;
---

<section aria-labelledby="secure-data-title" class="my-16 md:my-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 md:flex md:items-center md:gap-8 lg:px-8">
    <div>
      <h2
        id="secure-data-title"
        class="font-clash-display-bold mb-4 text-3xl text-slate-800 md:text-4xl"
      >
        {title}
      </h2>
      <p class="text-primary-600 mb-1 font-bold">{subtitle}</p>
      <p class="text-lg text-slate-500">{description}</p>
    </div>
    <div class="mb-8 flex justify-center md:mb-0 md:justify-end">
      <Image src={dataBaseImg} alt="Database icon representing secure data storage" inferSize />
    </div>
  </div>
</section>
