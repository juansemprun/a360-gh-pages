---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import { Card } from '@/components/ui/react/shadcn/card';
import { Badge } from '@/components/ui/react/shadcn/badge';

import { ArrowRight } from '@lucide/astro';

interface PartnersCardProps {
  ctaRequestExpertText: string;
  description: string;
  name: string;
  tags: string[];
  bonus?: string;
  spotlight?: string;
  website?: string;
  image: {
    alt: string;
    src: ImageMetadata;
  };
}

const { lang } = Astro.params;
const { name, image, description, bonus, spotlight, website, tags, ctaRequestExpertText } =
  Astro.props as PartnersCardProps;
---

<Card className="overflow-hidden border-0 bg-transparent shadow-none">
  <article class="flex flex-col gap-12 sm:flex-row">
    <div class="shrink-0">
      <Image
        src={image.src}
        alt={image.alt}
        width={260}
        height={146}
        class="aspect-16/9 w-full object-cover object-center sm:w-[260px]"
      />
    </div>
    <div class="flex-1 space-y-6">
      <h3 class="text-xl font-bold leading-tight lg:text-2xl">{name}</h3>

      <p class="text-muted-foreground text-base">{description}</p>

      {
        bonus && (
          <div class="bg-primary-50 border-primary-200 rounded-lg border-2 border-dashed p-4">
            <p class="text-primary-900 text-sm">
              <strong class="font-semibold">🎁 Bonus:</strong> {bonus}
            </p>
          </div>
        )
      }

      {
        spotlight && (
          <div class="rounded-lg border-2 border-dashed border-yellow-200 bg-yellow-50 p-4">
            <p class="text-sm text-yellow-900">
              <strong class="font-semibold">⭐ Partner Spotlight:</strong> {spotlight}
            </p>
          </div>
        )
      }

      {
        website && (
          <p class="text-muted-foreground text-sm">
            <strong class="font-medium">Website:</strong>{' '}
            <a
              href={`https://${website}`}
              class="text-primary hover:text-primary/80 underline transition-colors"
              target="_blank"
              rel="noopener noreferrer"
            >
              {website}
            </a>
          </p>
        )
      }

      <div class="flex flex-wrap items-center gap-3">
        {
          tags.map((tag) => (
            <Badge
              key={tag}
              variant="secondary"
              className="border-primary-300 border bg-white text-xs font-medium"
            >
              {tag}
            </Badge>
          ))
        }
      </div>

      <a
        href={`${import.meta.env.BASE_URL}/${lang}/request-expert`}
        class="text-primary focus:ring-primary group inline-flex items-center rounded font-medium hover:underline focus:outline-none focus:ring-2 focus:ring-offset-2"
      >
        {ctaRequestExpertText}
        <ArrowRight
          class="ml-2 size-4 transition duration-200 ease-in-out group-hover:translate-x-0.5"
        />
      </a>
    </div>
  </article>
</Card>
