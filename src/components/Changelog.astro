---
import GradientText from '@/components/ui/GradientText.astro';

import { Card, CardContent } from '@/components/ui/shadcn/card';
import { Separator } from '@/components/ui/shadcn/separator';

type TimelineEntry = {
  date: string;
  title: string;
  content: string;
};

const timelineData: TimelineEntry[] = [
  {
    date: 'December 23, 2024',
    title: 'Better export options',
    content:
      "The term 'Artificial Intelligence' was coined at the Dartmouth Conference, marking the official beginning of AI as a field. John McCarthy, Marvin Minsky, Nathaniel Rochester, and Claude Shannon organized this seminal event, setting the stage for decades of research and development.",
  },
  {
    date: 'January 11, 2025',
    title: 'New dashboard and analytics',
    content:
      'The early years saw significant optimism with programs like ELIZA (the first chatbot) and SHRDLU (a natural language understanding system). However, by the early 1970s, funding dried up as researchers faced the limitations of early computing power and the complexity of human intelligence.',
  },
  {
    date: 'December 23, 2024',
    title: 'Better export options',
    content:
      "The term 'Artificial Intelligence' was coined at the Dartmouth Conference, marking the official beginning of AI as a field. John McCarthy, Marvin Minsky, Nathaniel Rochester, and Claude Shannon organized this seminal event, setting the stage for decades of research and development.",
  },
  {
    date: 'January 11, 2025',
    title: 'New dashboard and analytics',
    content:
      'The early years saw significant optimism with programs like ELIZA (the first chatbot) and SHRDLU (a natural language understanding system). However, by the early 1970s, funding dried up as researchers faced the limitations of early computing power and the complexity of human intelligence.',
  },
];
---

<section class="container-custom py-32" data-theme="dark">
  <div class="mx-auto md:max-w-3xl">
    <div class="text-center">
      <GradientText
        animationSpeed={15}
        className="font-clash-display-bold text-5xl transition duration-300 md:text-7xl"
        showBorder={true}
        colors={['#2d92e9', '#644ad5', '#c147ac', '#f04d66', '#fd7043']}
      >
        <h1>Changelog</h1>
      </GradientText>
      <div
        class="bg-muted mx-auto mt-10 flex w-full items-center justify-center gap-2 rounded-2xl p-3 md:gap-4"
      >
        <p class="text-muted-foreground text-xl">
          New features, improvements, and fixes every week
        </p>
      </div>
    </div>
    <div class="border-border mx-auto mt-20 space-y-10 border-l border-dashed pl-6">
      <div>
        <p class="text-muted-foreground relative text-lg">
          <time class="bg-primary-400 absolute -left-6 top-1 h-3 w-3 -translate-x-1/2 rounded-full"
          ></time>
          January 11, 2025
        </p>
        <img
          src="https://www.air360.io/images/changelog/2025-06-30/nextImageExportOptimizer/hero-opt-1920.WEBP"
          alt="Better export options"
          class="my-4 rounded-2xl object-contain"
        />
        <h2 class="mb-2 text-3xl font-semibold">Better export options</h2>
        <p class="prose text-primary/80 dark:prose-invert">
          We've added a <a href="#">components</a> and <a href="#">analytics</a> to help you track your
          website's performance. You can now see your website's performance over time, and get insights
          into your users.
          <br />
          <br />
          As with all of our <a href="#">integrations</a>, we do the heavy lifting for you. It's
          easy to set up, privacy-focused, performant, and secure. We also handle cookie consent
          where required, in a very Supertape way.
        </p>
      </div>
      <div>
        <p class="text-muted-foreground relative text-lg">
          <time class="bg-primary-400 absolute -left-6 top-1 h-3 w-3 -translate-x-1/2 rounded-full"
          ></time>
          December 23, 2024
        </p>
        <img
          src="https://www.air360.io/images/changelog/2024-02-26/nextImageExportOptimizer/headerImage-opt-1920.WEBP"
          alt="placeholder"
          class="my-4 rounded-2xl object-contain"
        />
        <h2 class="mb-2 text-3xl font-semibold">New dashboard and analytics</h2>
        <p class="prose text-primary/80 dark:prose-invert">
          We've added a <a href="#">components</a> and <a href="#">analytics</a> to help you track your
          website's performance. You can now see your website's performance over time, and get insights
          into your users.
          <br />
          <br />
          As with all of our <a href="#">integrations</a>, we do the heavy lifting for you. It's
          easy to set up, privacy-focused, performant, and secure. We also handle cookie consent
          where required, in a very Supertape way.
        </p>
      </div>
    </div>
  </div>
</section>

<section class="bg-background container-custom py-32" data-theme="dark">
  <div class="mx-auto">
    <div class="relative mx-auto max-w-3xl">
      <Separator orientation="vertical" client:idle className="bg-muted absolute left-2 top-4" />
      {
        timelineData.map((entry) => (
          <div class="relative mb-10 pl-8">
            <div class="bg-primary-500 absolute left-0 top-3.5 flex size-4 items-center justify-center rounded-full" />
            <h4 class="rounded-xl py-2 text-2xl font-bold tracking-tight xl:mb-4 xl:px-3">
              {entry.title}
            </h4>

            <h5 class="text-md text-muted-foreground -left-40 top-3 rounded-xl tracking-tight xl:absolute">
              {entry.date}
            </h5>

            <Card className="my-5 border-none shadow-none">
              <CardContent className="px-0 xl:px-2">
                <img
                  src="https://www.air360.io/images/changelog/2025-06-30/nextImageExportOptimizer/hero-opt-1920.WEBP"
                  alt="Better export options"
                  class="my-4 rounded-2xl object-contain"
                />
                <h2 class="mb-2 text-3xl font-semibold">Better export options</h2>
                <p class="prose text-primary/80 dark:prose-invert">
                  We've added a <a href="#">components</a> and <a href="#">analytics</a> to help you
                  track your website's performance. You can now see your website's performance over
                  time, and get insights into your users.
                  <br />
                  <br />
                  As with all of our <a href="#">integrations</a>, we do the heavy lifting for you.
                  It's easy to set up, privacy-focused, performant, and secure. We also handle
                  cookie consent where required, in a very Supertape way.
                </p>
              </CardContent>
            </Card>
          </div>
        ))
      }
    </div>
  </div>
</section>
