---
import GradientText from '@ui/GradientText.astro';
---

<header class="mx-auto flex max-w-3xl flex-col items-center gap-4 text-center" role="banner">
  <GradientText animationSpeed={30}>
    <h1 class="font-clash-display-bold text-balance text-4xl md:text-7xl">Air360 Blog</h1>
  </GradientText>
  <p class="text-muted-foreground text-sm md:text-xl">
    Explore our blog for insightful articles, personal reflections and ideas that inspire action on
    the topics you care about.
  </p>
</header>
