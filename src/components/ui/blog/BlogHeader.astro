---
import GradientText from '@ui/GradientText.astro';

import { useTranslations } from '@/i18n/utils';
import BlogNav from './BlogNav.astro';
// const { lang = 'en' } = Astro.params;
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<header class="mx-auto flex max-w-3xl flex-col items-center gap-5 text-center" role="banner">
  <GradientText animationSpeed={30}>
    <h1 class="font-clash-display-bold text-balance text-4xl md:text-7xl">
      {t('title')}
    </h1>
  </GradientText>
  <p class="text-muted-foreground text-sm md:text-xl">
    {t('description')}
  </p>
</header>
