---
import type { LanguageCode } from '@/config/language';
import { useTranslations } from '@/i18n';

import GradientText from '@ui/GradientText.astro';

interface Props {
  lang: LanguageCode;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="mx-auto flex max-w-3xl flex-col items-center gap-5 text-center">
  <GradientText animationSpeed={30}>
    <h1 class="font-clash-display-bold text-balance text-4xl md:text-7xl">
      {t('blog.title')}
    </h1>
  </GradientText>
  <p class="text-muted-foreground text-sm md:text-xl">
    {t('blog.description')}
  </p>
</header>
