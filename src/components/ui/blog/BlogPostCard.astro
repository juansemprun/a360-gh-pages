---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

import { format, type Locale } from 'date-fns';
import { fr, ja } from 'date-fns/locale';

import { Badge } from '@ui/shadcn/badge';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: string;
}

const { post, lang } = Astro.props;

// Extract slug without language prefix
const [, ...slugParts] = post.slug.split('/');
const slug = slugParts.join('/');

// Build the post URL
const postUrl = `${import.meta.env.BASE_URL}/${lang}/blog/${slug}`;

const localeMap: Record<string, Locale | undefined> = {
  fr: fr,
  ja: ja,
};

// Format the date once
const formattedDate = format(post.data.published, 'MMMM dd, yyyy', {
  locale: localeMap[lang],
});
---

<article class="group flex flex-col overflow-hidden rounded-lg transition-shadow hover:shadow-sm">
  <a href={postUrl} class="block">
    <div class="relative overflow-hidden">
      <Image
        src={post.data.image}
        alt={post.data.title}
        width={600}
        height={400}
        class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />

      {
        post.data.tags && post.data.tags.length > 0 && (
          <div class="absolute right-4 top-4 flex flex-wrap gap-2">
            {post.data.tags.slice(0, 2).map((tag) => (
              <Badge
                variant="secondary"
                className="bg-background/70 px-3 py-1 text-sm backdrop-blur-sm"
              >
                {tag}
              </Badge>
            ))}
          </div>
        )
      }
    </div>
  </a>

  <div class="flex flex-1 flex-col gap-4 p-4">
    <header>
      <h2 class="text-xl font-semibold leading-tight">
        <a href={postUrl} class="hover:underline">
          {post.data.title}
        </a>
      </h2>
    </header>

    <p class="text-muted-foreground line-clamp-3 text-sm">
      {post.data.metaDesc}
    </p>

    <footer class="text-muted-foreground mt-auto flex items-center justify-between gap-4 text-sm">
      <time datetime={post.data.published.toISOString()} class="flex items-center gap-1.5">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
          <line x1="16" x2="16" y1="2" y2="6"></line>
          <line x1="8" x2="8" y1="2" y2="6"></line>
          <line x1="3" x2="21" y1="10" y2="10"></line>
        </svg>
        <span>{formattedDate}</span>
      </time>

      <span class="flex items-center gap-1.5">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>{post.data.readingTime} min</span>
      </span>
    </footer>
  </div>
</article>
