---
import GradientText from '@/components/ui/GradientText.astro';
---

<header class="mx-auto md:max-w-3xl">
  <div class="text-center">
    <GradientText className="font-clash-display-bold text-5xl transition duration-300 md:text-7xl">
      <h1>Changelog</h1>
    </GradientText>
    <div
      class="bg-muted mx-auto mt-10 flex w-full items-center justify-center gap-2 rounded-2xl p-3 md:gap-4"
    >
      <p class="text-muted-foreground text-xl">New features, improvements, and fixes every week</p>
    </div>
  </div>
</header>
