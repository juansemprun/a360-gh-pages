---
import GradientText from '@/components/ui/GradientText.astro';
---

<header class="mx-auto md:max-w-3xl">
  <div class="flex flex-col items-center gap-10 text-center">
    <GradientText className="font-clash-display-bold text-5xl transition duration-300 md:text-7xl">
      <h1>Changelog</h1>
    </GradientText>
    <div
      class="bg-muted mx-auto flex w-full items-center justify-center gap-2 rounded-xl p-3 md:gap-4"
    >
      <p class="text-lg text-slate-700 md:text-xl">
        New features, improvements, and fixes every week
      </p>
    </div>
  </div>
</header>
