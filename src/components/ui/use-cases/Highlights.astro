---
interface HighlightedItem {
  title: string;
  text: string;
}

interface Props {
  highlightsList: HighlightedItem[];
}

const { highlightsList }: Props = Astro.props;
---

<section class="mx-auto" data-theme="dark">
  {
    highlightsList.map(({ title, text }) => (
      <div class="sticky-statement mt-0 h-[65vh]">
        <div class="text-cente sticky top-[40vh]">
          <h3 class="split font-clash-display-bold mb-2.5 text-center text-xl text-slate-800 md:text-7xl">
            {title}
          </h3>
          <p class="mx-auto mt-10 max-w-3xl text-pretty text-center text-base text-slate-500 md:text-3xl">
            {text}
          </p>
        </div>
      </div>
    ))
  }
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  function startHighlightsAnimation() {
    gsap.registerPlugin(ScrollTrigger);

    const stickyEls = document.querySelectorAll('.sticky-statement');

    stickyEls.forEach((el) => {
      let tl = gsap.timeline({
        scrollTrigger: {
          trigger: el,
          start: 'top 80%',
          end: 'bottom 30%',
          toggleActions: 'play none reverse none',
          scrub: 2,
        },
      });
      tl.from(el, { opacity: 0, scale: 0.8, yPercent: 20 });
      tl.to(el, { opacity: 0, scale: 0.8, yPercent: -20 });
    });
  }

  document.addEventListener('astro:page-load', startHighlightsAnimation, { once: false });
</script>
