---
import GradientText from '@components/ui/GradientText.astro';

interface HighlightedItem {
  title: string;
  text: string;
}

interface Props {
  highlightsList: HighlightedItem[];
}

const { highlightsList }: Props = Astro.props;
const highlightsListTitles = highlightsList.map(({ title }) => ({ title }));
---

<section class="mx-auto my-32 text-center" data-theme="dark">
  <ul class="font-clash-display-bold mb-12 space-y-3 text-3xl text-slate-600 md:text-5xl">
    {
      highlightsListTitles.map(({ title }) => (
        <li class="mb-7 cursor-default gap-y-4 transition duration-300">
          <GradientText animationSpeed={3} className="transition duration-300" hoverOnly={true}>
            {title}
          </GradientText>
        </li>
      ))
    }
  </ul>
</section>
