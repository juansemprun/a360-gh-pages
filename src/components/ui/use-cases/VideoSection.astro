---
interface VideoSectionProps {
  videoSrc: string;
}

const { videoSrc } = Astro.props as VideoSectionProps;
---

<section class="my-28 flex flex-col justify-center">
  <h2
    class="font-clash-display-bold mb-10 text-center text-2xl leading-tight tracking-wide text-slate-600 md:text-4xl"
  >
    <slot />
  </h2>

  <div class="relative h-0 pb-[56.25%]">
    <iframe
      src={videoSrc}
      allowfullscreen
      class="absolute left-0 top-0 h-full w-full rounded-xl shadow-lg"></iframe>
  </div>
</section>
