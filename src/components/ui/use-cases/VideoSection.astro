---
import { Play } from '@lucide/astro';

interface Props {
  videoSrc: string;
  videoPosterSrc: string;
  videoPreviewSrc?: string; // Optional preview/teaser video
}

const { videoSrc, videoPosterSrc, videoPreviewSrc } = Astro.props;
---

<section class="my-28" aria-labelledby="video-section-title" data-theme="dark">
  <h2
    id="video-section-title"
    class="font-clash-display-bold mb-10 text-center text-2xl leading-tight tracking-wide text-slate-600 md:text-4xl"
  >
    <slot />
  </h2>

  <div class="video-wrapper relative h-0 pb-[56.25%]">
    <!-- Preview Video (looping, muted, autoplay) -->
    {
      videoPreviewSrc && (
        <video
          class="preview-video absolute left-0 top-0 h-full w-full rounded-xl object-cover"
          autoplay
          muted
          loop
          playsinline
          poster={videoPosterSrc}
          preload="auto"
        >
          <source src={videoPreviewSrc} type="video/mp4" />
        </video>
      )
    }

    <!-- Main Video (hidden initially) -->
    <video
      class="main-video absolute left-0 top-0 h-full w-full rounded-xl opacity-0"
      preload="metadata"
      poster={videoPosterSrc}
    >
      <source src={videoSrc} type="video/mp4" />
      <p>
        Your browser doesn't support HTML video. Here is a
        <a href={videoSrc} class="underline hover:text-slate-800">link to the video</a> instead.
      </p>
    </video>

    <!-- Play Button Overlay -->
    <button
      type="button"
      class="play-button focus:ring-primary-300 absolute left-1/2 top-1/2 z-10 flex h-20 w-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white shadow-lg ring ring-black/10 transition-transform duration-300 ease-in-out hover:scale-110 hover:cursor-pointer hover:bg-white focus:outline-none focus:ring-4 md:h-24 md:w-24"
      aria-label="Play video"
    >
      <div class="m-auto aspect-square w-1/2">
        {/* <Play className="h-full! w-full! fill-white stroke-white" /> */}
        <Play class="fill-primary-500 h-full! w-full! stroke-0 md:h-12 md:w-12" />
      </div>
    </button>
  </div>
</section>

<script>
  function initVideoPlayers() {
    const videoWrappers = document.querySelectorAll('.video-wrapper');

    videoWrappers.forEach((wrapper) => {
      const mainVideo = wrapper.querySelector('.main-video') as HTMLVideoElement;
      const previewVideo = wrapper.querySelector('.preview-video') as HTMLVideoElement | null;
      const playButton = wrapper.querySelector('.play-button') as HTMLButtonElement;

      if (!mainVideo || !playButton) return;

      // Play main video when button is clicked
      playButton.addEventListener('click', () => {
        // Pause and hide preview video if it exists
        if (previewVideo) {
          previewVideo.pause();
          previewVideo.style.opacity = '0';
          previewVideo.style.pointerEvents = 'none';
        }

        // Show and play main video with controls
        mainVideo.style.opacity = '1';
        mainVideo.controls = true;
        mainVideo.play();
      });

      // Hide button when main video starts playing
      mainVideo.addEventListener('play', () => {
        playButton.classList.add('opacity-0', 'pointer-events-none');
      });

      // Show button when main video is paused
      mainVideo.addEventListener('pause', () => {
        playButton.classList.remove('opacity-0', 'pointer-events-none');
      });

      // Show button and reset to preview when main video ends
      mainVideo.addEventListener('ended', () => {
        playButton.classList.remove('opacity-0', 'pointer-events-none');

        // Optional: Reset to preview video after main video ends
        if (previewVideo) {
          mainVideo.style.opacity = '0';
          mainVideo.controls = false;
          mainVideo.currentTime = 0;

          previewVideo.style.opacity = '1';
          previewVideo.style.pointerEvents = 'auto';
          previewVideo.play();
        }
      });
    });
  }

  // Initialize on page load
  initVideoPlayers();

  // Re-initialize after view transitions
  document.addEventListener('astro:page-load', () => {
    initVideoPlayers();
  });
</script>
