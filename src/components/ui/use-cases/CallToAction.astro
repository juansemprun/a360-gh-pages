---
import GradientButton from '@ui/GradientButton.astro';
import MochiFlying from '@assets/images/mochi/svg/mochi-flying.svg';
---

<section class="my-32 flex flex-col items-center" data-theme="dark">
  <MochiFlying class="mb-4 w-24" />
  <h2
    class="font-clash-display-bold mx-auto mb-10 text-center text-5xl font-bold text-gray-700 md:text-7xl"
  >
    Increase your <br />
    <span> conversions </span>
  </h2>
  <GradientButton
    title="Get started"
    className="w-80 px-8 py-4 text-lg shadow-md transition-all duration-300 ease-in-out hover:-translate-y-0.5 hover:shadow-xl"
  />
</section>
