---
import {
  CartShopping,
  ClapperboardPlay,
  Database,
  FilterCircleDollar,
  MesssageExclamation,
  RobotAstromech,
  SquareKanban,
  UserMagnifyingGlass,
} from '@assets/icons';

const features = [
  {
    icon: RobotAstromech,
    label: 'Auto-tracking',
  },
  {
    icon: Database,
    label: 'Custom data collection',
  },
  {
    icon: MesssageExclamation,
    label: 'No-code error detection',
  },
  {
    icon: SquareKanban,
    label: 'Advanced segments',
  },
  {
    icon: FilterCircleDollar,
    label: 'Funnel analysis',
  },
  {
    icon: CartShopping,
    label: 'User journeys',
  },
  {
    icon: UserMagnifyingGlass,
    label: 'On-page analysis',
  },
  {
    icon: ClapperboardPlay,
    label: 'Session replays',
  },
];
---

<section class="mx-auto my-32">
  <h2
    class="font-clash-display-semibold mx-auto my-20 max-w-xl text-center text-2xl text-slate-800 md:text-3xl"
  >
    Everything you need to create <br /> the best possible user experience
  </h2>
  <div class="mx-auto grid max-w-full grid-cols-2 gap-8 text-slate-700 sm:grid-cols-4">
    {
      features.map(({ icon: Icon, label }) => (
        <div class="flex flex-col items-center gap-3">
          <span class="h-15 w-15 flex items-center justify-center rounded-xl bg-pink-100 text-pink-600">
            <Icon class="text-primary-600 h-10 w-10 fill-current p-1" aria-hidden="true" />
          </span>
          <h3 class="text-center text-xl font-semibold">{label}</h3>
        </div>
      ))
    }
  </div>
</section>
