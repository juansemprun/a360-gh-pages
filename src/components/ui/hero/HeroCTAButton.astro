---
interface HeroCTAButtonProps {
  ctaText: string;
  lang: string;
}

const { ctaText, lang } = Astro.props as HeroCTAButtonProps;
---

<a
  href={`/${lang}/request-demo`}
  class="bg-primary-500 inline-flex w-80 items-center justify-center rounded-xl px-8 py-4 text-lg transition-all duration-200 hover:-translate-y-0.5"
>
  <span class="text-lg font-semibold text-white">{ctaText}</span>
</a>
