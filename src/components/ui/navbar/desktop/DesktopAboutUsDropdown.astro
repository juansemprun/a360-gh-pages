---
import { getEntry } from 'astro:content';
import Icon from '@components/ui/Icon.astro';

const { lang } = Astro.params;
const entry = await getEntry('navigation', `${lang}/about-us`);

if (!entry) {
  return Astro.redirect('/404');
}

const primarySections = entry.data.aboutUsNav?.primary || [];
const secondarySections = entry.data.aboutUsNav?.secondary || [];
---

<li class="group/dropdown relative" role="none" data-dropdown>
  <button
    class="ease cursor-pointer py-2 text-base font-medium text-inherit no-underline transition-colors duration-300 group-hover/dropdown:text-gray-400"
    role="menuitem"
    aria-haspopup="true"
    aria-expanded="false"
    data-dropdown-trigger
  >
    {entry?.data.title}
    <Icon
      name="ChevronDown"
      width={16}
      height={16}
      class="inline fill-current transition-transform duration-300 ease-in-out group-hover/dropdown:rotate-180 group-hover/dropdown:fill-gray-400"
    />
  </button>
  <div
    role="menu"
    aria-label="Features menu"
    data-dropdown-menu
    class="pointer-events-none fixed left-1/2 max-w-3xl -translate-x-1/2 -translate-y-2.5 scale-95 transform rounded-2xl bg-white opacity-0 shadow-md ring ring-black/5 transition-all duration-300 group-hover/dropdown:pointer-events-auto group-hover/dropdown:-translate-x-1/2 group-hover/dropdown:translate-y-0 group-hover/dropdown:scale-100 group-hover/dropdown:opacity-100"
  >
    <div class="flex flex-row gap-8">
      <div class="flex-1/2 rounded-2xl p-8 pr-0">
        <h3 class="mb-5 text-xs font-semibold uppercase tracking-wider text-gray-400">TITLE</h3>
        <div class="flex flex-col gap-4">
          {
            secondarySections.map(({ icon, label, link }) => {
              return (
                <a
                  href={`/website/${lang}${link}`}
                  class="hover:shadow-xs group flex gap-3 rounded-lg p-2 transition-all duration-300 ease-in-out hover:-translate-y-0.5 hover:bg-slate-50 hover:ring hover:ring-black/5"
                  role="menuitem"
                >
                  <Icon
                    name={icon}
                    width={20}
                    height={20}
                    class="group-hover:fill-primary-500 mx-1.5 flex justify-center fill-gray-400 transition-colors"
                  />
                  <h4 class="text-sm text-black">{label}</h4>
                </a>
              );
            })
          }
        </div>
      </div>
      <div class="rounded-br-2xl rounded-tr-2xl bg-slate-50 p-8">
        <h3 class="mb-5 text-xs font-semibold uppercase tracking-wider text-gray-400">TITLE</h3>
        <div class="flex flex-col justify-between gap-6">
          {
            primarySections.map(({ icon, label, link }) => {
              return (
                <a
                  href={`/website/${lang}${link}`}
                  class="group flex cursor-pointer flex-col items-center justify-center gap-2.5 rounded-xl p-4 transition-all duration-300 ease-in-out hover:-translate-y-0.5"
                  role="menuitem"
                >
                  <Icon
                    name={icon}
                    width={32}
                    height={32}
                    class="group-hover:fill-primary-500 mx-1.5 flex justify-center fill-gray-400 transition-colors"
                  />
                  <h4 class="text-black">{label}</h4>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</li>
