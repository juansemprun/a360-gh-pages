---
import { getEntry } from 'astro:content';

import Icon from '@ui/Icon.astro';

const { lang } = Astro.params;

const entry = await getEntry('navigation', `${lang}/features`);

if (!entry) {
  return Astro.redirect('/404');
}

const navigation = entry.data.navigation || [];
---

<li class="group/dropdown relative" role="none">
  <button
    role="menuitem"
    aria-haspopup="true"
    aria-expanded="false"
    class="ease cursor-pointer py-2 text-base font-medium text-inherit no-underline transition-colors duration-300 group-hover/dropdown:text-gray-400"
  >
    {entry.data.title}
    <Icon
      name="ChevronDown"
      width={16}
      height={16}
      class="inline fill-current transition-transform duration-300 ease-in-out group-hover/dropdown:rotate-180 group-hover/dropdown:fill-gray-400"
    />
  </button>
  <div
    role="menu"
    aria-label="Features menu"
    class="invisible fixed left-1/2 max-w-3xl -translate-x-1/2 -translate-y-2.5 scale-95 transform rounded-2xl bg-white opacity-0 shadow-md ring ring-black/5 duration-300 group-hover/dropdown:visible group-hover/dropdown:-translate-x-1/2 group-hover/dropdown:translate-y-0 group-hover/dropdown:scale-100 group-hover/dropdown:transform group-hover/dropdown:opacity-100 group-hover/dropdown:duration-300"
    role="menu"
    aria-label="Features menu"
  >
    <div class="grid grid-cols-2 gap-8">
      <div class="flex-1/2 rounded-2xl p-8 pr-0">
        <h3 class="mb-5 text-xs font-semibold uppercase tracking-wider text-gray-400">
          {entry.data.sectionTitles?.classics}
        </h3>
        <div class="flex flex-col gap-x-3">
          {
            navigation.map(({ icon, label, link, description }) => (
              <a
                href={`/website/${lang}${link}`}
                role="menuitem"
                class="hover:shadow-xs group flex items-center gap-2 rounded-lg py-4 transition-all duration-300 ease-in-out hover:-translate-y-0.5 hover:cursor-pointer hover:bg-slate-50 hover:ring hover:ring-black/5"
              >
                <Icon
                  name={icon}
                  width={20}
                  height={20}
                  class="group-hover:fill-primary-500 mx-1.5 fill-gray-400 transition-colors"
                />
                <div class="gap-2">
                  <h4 class="text-sm text-black">{label}</h4>
                  <p class="text-xs text-gray-500">{description}</p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
      <div class="rounded-br-2xl rounded-tr-2xl bg-slate-50 p-8">
        <h3 class="mb-5 text-xs font-semibold uppercase tracking-wider text-gray-400">
          {entry.data.sectionTitles?.release}
        </h3>
        <div class="gap-2">
          <div
            class="hover:shadow-xs cursor-pointer rounded-xl p-4 transition-all duration-300 ease-in-out hover:-translate-y-0.5 hover:bg-white/80 hover:ring hover:ring-black/5"
          >
            <video class="mb-5 h-auto w-full rounded-lg" autoplay loop playsinline muted>
              <source
                src="https://cdn.loom.com/sessions/thumbnails/ec06bf3738f64c8e960b2c0eccaf89b0-00001.mp4"
                type="video/mp4"
              />
              Sorry, your browser does not support embedded videos.
            </video>
            <h4 class="text-md mb-3 font-bold text-black">{entry?.data?.video?.title}</h4>
            <p class="text-sm text-black/70">{entry?.data?.video?.description}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</li>
