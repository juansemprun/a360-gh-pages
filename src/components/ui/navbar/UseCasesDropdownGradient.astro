---
import {
  TicketAirline,
  Sitemap,
  Hotel,
  Gem,
  GamepadModern,
  CourtSport,
  BuildingColumns,
  BagsShopping,
  ChevronDown,
} from '@assets/icons';

const useCasesByIndustry = [
  { icon: BagsShopping, label: 'E-commerce', link: '/' },
  { icon: Hotel, label: 'Hotels', link: '/' },
  { icon: Gem, label: 'Luxury brands', link: '/' },
  { icon: TicketAirline, label: 'Airlines', link: '/' },
  { icon: GamepadModern, label: 'Gaming', link: '/' },
  { icon: BuildingColumns, label: 'Bank & Insurance', link: '/' },
  { icon: Sitemap, label: 'Multi-brand companies', link: '/' },
  { icon: CourtSport, label: 'Sport team', link: '/' },
];

const useCasesByUseCase = [
  { icon: Gem, label: 'Refine funnels', description: 'Lorem ipsum dolor', link: '/' },
  { icon: Gem, label: 'Resolve errors', description: 'Lorem ipsum dolor', link: '/' },
  { icon: Gem, label: 'Increase conversions', description: 'Lorem ipsum dolor', link: '/' },
  { icon: Gem, label: 'Centralize data', description: 'Lorem ipsum dolor', link: '/' },
  {
    icon: Gem,
    label: 'Automate analysis',
    description: 'Lorem ipsum dolor',
    link: '/',
  },
  { icon: Gem, label: 'Uncover insights', description: 'Lorem ipsum dolor', link: '/' },
  { icon: Gem, label: 'Upgrade mobile apps', description: 'Lorem ipsum dolor', link: '/' },
  { icon: Gem, label: 'Boost productivity', description: 'Lorem ipsum dolor', link: '/' },
  {
    icon: Gem,
    label: 'Accelerate innovation',
    description: 'Lorem ipsum dolor',
    link: '/',
  },
  { icon: Gem, label: 'Reduce spend', description: 'Lorem ipsum dolor', link: '/' },
  {
    icon: Gem,
    label: 'Improve troubleshooting',
    description: 'Lorem ipsum dolor',
    link: '/',
  },
];
---

<li class="group/dropdown relative" role="none">
  <button
    role="menuitem"
    aria-haspopup="true"
    aria-expanded="false"
    class="ease cursor-pointer py-2 text-base font-medium text-inherit no-underline transition-colors duration-300 group-hover/dropdown:text-gray-400"
  >
    Use Cases
    <ChevronDown
      width="16"
      height="16"
      class="inline fill-current transition-transform duration-300 ease-in-out group-hover/dropdown:rotate-180 group-hover/dropdown:fill-gray-400"
    />
  </button>
  <div
    role="menu"
    aria-label="Use Cases menu"
    class="invisible fixed left-1/2 max-w-3xl -translate-x-1/2 -translate-y-2.5 scale-95 transform rounded-2xl bg-white opacity-0 duration-300 group-hover/dropdown:visible group-hover/dropdown:-translate-x-1/2 group-hover/dropdown:translate-y-0 group-hover/dropdown:scale-100 group-hover/dropdown:transform group-hover/dropdown:opacity-100 group-hover/dropdown:duration-300"
  >
    <div class="flex flex-row gap-8">
      <div class="flex-1/2 rounded-2xl p-8 pr-0">
        <h3 class="mb-5 text-xs font-semibold uppercase tracking-wider text-gray-400">
          By Use Case
        </h3>
        <div class="grid grid-cols-2 gap-x-8">
          {
            useCasesByUseCase.map(({ icon: Icon, label, link }) => (
              <a
                href={link}
                role="menuitem"
                class="group flex gap-2 rounded-xl py-4 transition-all duration-300 ease-in-out hover:-translate-y-0.5 hover:cursor-pointer hover:bg-slate-50"
              >
                <Icon
                  width="20"
                  height="20"
                  class="group-hover:fill-primary-500 mx-1.5 flex justify-center fill-gray-400 transition-colors"
                />
                <div class="gap-2">
                  <h4 class="text-sm text-black">{label}</h4>
                  <p class="text-xs text-gray-500">Lorem ipsum dolor</p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
      <div class="rounded-br-2xl rounded-tr-2xl bg-slate-50 p-8">
        <h3 class="mb-5 text-xs font-semibold uppercase tracking-wider text-gray-400">
          By industry
        </h3>
        <div class="gap-2">
          {
            useCasesByIndustry.map(({ icon: Icon, label, link }) => (
              <a href={link} role="menuitem">
                <div class="group flex cursor-pointer gap-2 rounded-xl py-4 transition-all duration-300 ease-in-out hover:-translate-y-0.5 hover:bg-slate-50">
                  <div class="group-hover:fill-primary-500 flex justify-center fill-gray-400 transition-colors">
                    <Icon width="20" height="20" />
                  </div>
                  <h4 class="text-sm text-black">{label}</h4>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</li>
