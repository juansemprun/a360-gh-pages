---
import FeatureTabsCarousel from '@/components/react/FeatureTabsCarousel';

interface Feature {
  id: string;
  heading: string;
  video: string;
  poster?: string;
  isDefault: boolean;
}

interface Props {
  features?: Feature[];
}

const { features = [] as Feature[] } = Astro.props;
---

<section class="w-full py-16" data-theme="light">
  <FeatureTabsCarousel features={features} client:load />
</section>
