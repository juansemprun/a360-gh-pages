---
import type { CollectionEntry } from 'astro:content';

import Logo from '@assets/images/logo.svg';

interface FooterProps {
  lang: string;
  navigationCollection: CollectionEntry<'navigation'>[];
}

const { lang, navigationCollection } = Astro.props as FooterProps;

const [aboutUs, features, useCases, resources] = navigationCollection;
---

<footer data-theme="dark" class="bg-linear-180 from-[#27154c] to-[#181127]">
  <div class="container-custom px-4 py-28">
    <!-- Top section with logo and social links -->
    <div class="mb-20 flex items-center justify-between">
      <a href={`/website/${lang}`} aria-label="Air360 homepage">
        <Logo class="text-white" />
      </a>
    </div>

    <!-- Main footer links section -->
    <nav class="mb-16 grid grid-cols-2 gap-8 md:grid-cols-4" aria-label="Footer navigation">
      <!-- Use Cases -->
      <div class="flex flex-col gap-9">
        <h3 class="text-lg font-bold text-white">{useCases.data.title}</h3>

        {
          useCases?.data?.useCasesNav?.industry?.map(({ link, label }) => (
            <a
              href={`/website/${lang}${link}`}
              class="text-sm font-medium text-white/80 transition-all duration-300 ease-in-out hover:translate-x-0.5 hover:underline"
            >
              {label}
            </a>
          ))
        }
      </div>

      <!-- About Us -->
      <div class="flex flex-col gap-9">
        <h3 class="text-lg font-bold text-white">{aboutUs.data.title}</h3>

        {
          aboutUs?.data?.aboutUsNav?.primary?.map(({ link, label }) => (
            <a
              href={`/website/${lang}${link}`}
              class="text-sm font-medium text-white/80 transition-all duration-300 ease-in-out hover:translate-x-0.5 hover:underline"
            >
              {label}
            </a>
          ))
        }
        {
          aboutUs?.data?.aboutUsNav?.secondary?.map(({ link, label }) => (
            <a
              href={`/website/${lang}${link}`}
              class="text-sm font-medium text-white/80 transition-all duration-300 ease-in-out hover:translate-x-0.5 hover:underline"
            >
              {label}
            </a>
          ))
        }
      </div>

      <!-- Resources column -->
      <div class="flex flex-col gap-9">
        <h3 class="text-lg font-bold text-white">{resources.data.title}</h3>

        {
          resources?.data?.navigation?.map(({ link, label }) => (
            <a
              href={`/website/${lang}${link}`}
              class="text-sm font-medium text-white/80 transition-all duration-300 ease-in-out hover:translate-x-0.5 hover:underline"
            >
              {label}
            </a>
          ))
        }
      </div>

      <!-- Company column -->
      <div class="flex flex-col gap-9">
        <h3 class="text-lg font-bold text-white">Company</h3>

        <a
          aria-label="Follow Air360 on LinkedIn"
          href="https://www.linkedin.com/company/air360/"
          rel="noopener noreferrer"
          target="_blank"
          class="transition-all duration-300 ease-in-out hover:translate-x-0.5"
        >
          <!-- LinkedIn icon -->
          <svg
            class="h-5 w-5 text-white/80"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M20.447 20.452h-3.556v-5.569c0-1.327-.026-3.033-1.85-3.033-1.85 0-2.134 1.445-2.134 2.938v5.664H9.35V9h3.415v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.6 0 4.267 2.37 4.267 5.45v6.291zM5.337 7a2.07 2.07 0 110-4.14A2.07 2.07 0 015.337 7zm1.778 13.452H3.56V9h3.555v11.452z"
            ></path>
          </svg>
        </a>
      </div>
    </nav>

    <!-- Footer bottom section -->
    <div class="pt-10">
      <div class="flex flex-col items-center md:flex-row">
        <div class="text-sm font-medium text-white/80">© 2025 Air360</div>
      </div>
    </div>
  </div>
</footer>
