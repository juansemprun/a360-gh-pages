---
// Dynamic Navbar Component with automatic theme adaptation
import Logo from '@assets/images/logo.svg';
import GradientButton from '@ui/GradientButton.astro';
import {
  FeaturesDropdownGradient,
  UseCasesDropdownGradient,
  AboutUsDropdownGradient,
  NavbarMobile,
} from '@ui/navbar';
---

<header id="dynamic-navbar">
  <nav class="navbar" role="navigation" aria-label="Main navigation">
    <div class="navbar-container">
      <!-- Logo -->
      <div class="navbar-logo">
        <a href="/" aria-label="Project homepage" id="navbar-logo">
          <Logo id="logo" class="fill-white" />
        </a>
      </div>

      <!-- Desktop Navigation Links -->
      <div class="navbar-menu desktop-menu">
        <ul class="navbar-nav" role="menubar">
          <!-- Features with Mega Menu -->
          <FeaturesDropdownGradient />

          <!-- Use Cases with Mega Menu -->
          <UseCasesDropdownGradient />

          <!-- About Us -->
          <AboutUsDropdownGradient />

          <li>
            <a href="/testimonials"> Testimonials </a>
          </li>
        </ul>
      </div>

      <!-- Desktop Auth Links -->
      <div class="navbar-auth desktop-auth">
        <a href="/login" class="auth-link login">Log in</a>
        <a href="/demo" class="auth-link demo">Book a Demo</a>
      </div>

      <!-- Mobile Hamburger Button -->
      <button
        class="mobile-menu-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="mobile-menu-button"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu">
      <NavbarMobile />
    </div>
  </nav>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background-color: rgba(255, 255, 255, 0.01);
    backdrop-filter: blur(24px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
  }

  /* Dark theme styles for the header */
  header.dark-theme {
    /*background-color: rgba(31, 41, 55, 0.95); /* Darker background */
    background-color: rgb(255, 255, 255); /* Darker background */
    border-bottom: 1px solid rgba(255, 255, 255, 0.1); /* Lighter border */
  }

  header.dark-theme .navbar-logo a {
    color: rgb(0, 0, 0); /* Logo text color in dark theme */
    fill: rgb(0, 0, 0);
  }

  header.dark-theme .navbar-logo #logo {
    fill: black;
  }

  header.dark-theme .navbar-link {
    color: #000 !important; /* Link color in dark theme */
  }

  header.dark-theme .navbar-nav {
    color: black;
  }

  header.dark-theme .navbar-link:hover {
    color: #000; /* Link hover color in dark theme */
  }

  header.dark-theme .auth-link {
    color: #000; /* Auth link color in dark theme */
  }

  header.dark-theme .auth-link:hover {
    color: #000; /* Auth link hover color in dark theme */
  }

  header.dark-theme .auth-link.demo {
    background: #f771bf; /* Demo button background in dark theme */
    color: white; /* Demo button text color in dark theme */
  }

  header.dark-theme .mobile-menu-toggle .hamburger-line {
    background-color: #d1d5db; /* Hamburger line color in dark theme */
  }

  header.dark-theme .mobile-menu-overlay {
    background: rgba(31, 41, 55, 0.98); /* Mobile menu overlay background in dark theme */
  }

  header.dark-theme .mobile-menu-content {
    background-color: rgba(31, 41, 55, 1); /* Mobile menu content background in dark theme */
  }

  header.dark-theme .mobile-nav-link {
    color: #d1d5db; /* Mobile nav link color in dark theme */
  }

  header.dark-theme .mobile-nav-link:hover {
    color: white; /* Mobile nav link hover color in dark theme */
  }

  header.dark-theme .mobile-auth-link {
    color: #d1d5db; /* Mobile auth link color in dark theme */
  }

  header.dark-theme .mobile-auth-link:hover {
    color: white; /* Mobile auth link hover color in dark theme */
  }

  header.dark-theme .mobile-close-btn {
    color: #d1d5db; /* Mobile close button color in dark theme */
  }

  header.dark-theme .mobile-close-btn:hover {
    color: white; /* Mobile close button hover color in dark theme */
    background-color: rgba(
      255,
      255,
      255,
      0.1
    ); /* Mobile close button hover background in dark theme */
  }

  .navbar-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .navbar-logo .logo-image {
    height: 24px;
    width: auto;
  }

  /* Desktop Menu Styles */
  .desktop-menu {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .navbar-nav {
    display: flex;
    align-items: center;
    gap: 40px;
    list-style: none;
    margin: 0;
    padding: 0;
    color: white;
  }

  .navbar-item {
    position: relative;
  }

  .navbar-link {
    color: white; /* Changed to white for gradient background */
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    padding: 8px 0;
    transition: color 0.2s ease;
    cursor: pointer;
  }

  .navbar-link:hover {
    color: #f8fafc; /* Lighter hover for white text */
  }

  .desktop-auth {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .auth-link {
    color: white;
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    transition: color 0.2s ease-in-out;
  }

  .auth-link:hover {
    color: #f8fafc;
  }

  .auth-link.login:hover {
    color: #b8bbbe;
  }

  .auth-link.demo {
    color: #000;
    padding: 8px 16px;
    border-radius: 8px;
    transition: all 0.2s ease;
    border-color: rgba(34, 34, 34, 0.15);
    box-shadow:
      rgba(0, 0, 0, 0.12) 0px 1px 2px 0px,
      rgba(0, 0, 0, 0.08) 0px 4px 6px 0px,
      rgba(0, 0, 0, 0) 0px 0.5px 1px 1px,
      rgba(0, 0, 0, 0) 0px 4px 12px 0px,
      rgba(255, 255, 255, 0.25) 0px 1px 1px 0px inset;
    background: radial-gradient(
        39.8% 100% at 50% 0%,
        rgb(255, 255, 255) 0%,
        rgb(249, 249, 250) 100%
      )
      rgba(0, 0, 0, 0);
  }

  .auth-link.demo:hover {
    color: black;
  }

  /* Mobile Menu Toggle Button */
  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    border-radius: 8px;
    transition: background-color 0.2s ease;
  }

  .mobile-menu-toggle:hover {
    background-color: rgba(255, 255, 255, 0.05); /* Changed for gradient background */
  }

  .mobile-menu-toggle:focus {
    outline: 2px solid #5e51f8;
    outline-offset: 2px;
  }

  .hamburger-line {
    width: 24px;
    height: 2px;
    background-color: white; /* Changed to white for gradient background */
    margin: 2px 0;
    transition: all 0.3s ease;
    border-radius: 1px;
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -6px);
  }

  /* Mobile Menu Overlay */
  .mobile-menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: white;
    z-index: 999;
    transform: translateY(-100%);
    transition: transform 0.3s ease;
    overflow-y: hidden;
  }

  .mobile-menu-overlay.active {
    transform: translateY(0);
  }

  .mobile-menu-content {
    height: 100vh;
    padding: 20px;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    background-color: white;
  }

  /* Mobile Auth Header */
  .mobile-auth {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
    padding-top: 20px;
  }

  .mobile-auth-link {
    color: #374151;
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    padding: 8px 16px;
    border-radius: 8px;
    transition: all 0.2s ease;
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .mobile-auth-link.demo {
    background: #5e51f8;
    color: white;
  }

  .mobile-close-btn {
    background: none;
    border: none;
    padding: 10px;
    cursor: pointer;
    color: #6b7280;
    border-radius: 8px;
    transition: background-color 0.2s ease;
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-close-btn:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }

  /* Mobile Navigation Sections */
  .mobile-nav-section {
    border-bottom: 1px solid #f3f4f6;
    display: flex;
    flex-direction: column;
  }

  .mobile-nav-link {
    display: block;
    padding: 20px 0;
    font-size: 18px;
    font-weight: 500;
    color: #111827;
    text-decoration: none;
    min-height: 44px;
    display: flex;
    align-items: center;
    transition: color 0.2s ease;
  }

  .mobile-nav-link:hover {
    color: #5e51f8;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .navbar-container {
      padding: 0 16px;
    }

    /* Hide desktop menu and auth */
    .desktop-menu,
    .desktop-auth {
      display: none;
    }

    /* Show mobile menu toggle */
    .mobile-menu-toggle {
      display: flex;
    }

    /* Ensure mobile menu is accessible */
    .mobile-menu-overlay {
      display: block;
    }
  }

  @media (min-width: 769px) {
    /* Hide mobile elements on desktop */
    .mobile-menu-toggle,
    .mobile-menu-overlay {
      display: none;
    }
  }

  /* Ensure proper touch targets on mobile */
  @media (max-width: 768px) {
    .mobile-nav-link,
    .mobile-auth-link,
    .mobile-close-btn {
      min-height: 44px;
      min-width: 44px;
    }
  }

  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .navbar {
      border-bottom: 2px solid #000;
    }

    .mobile-menu-overlay {
      border: 2px solid #000;
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu-overlay,
    .hamburger-line {
      transition: none;
    }
  }

  /* Fallback styles for non-JS scenarios */
  #dynamic-navbar {
    backdrop-filter: blur(12px);
  }

  /* Ensure proper contrast ratios for accessibility */
  .navbar-link:focus,
  .mobile-nav-link:focus {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  /* Enhanced mobile menu animation */
  #mobile-menu {
    transition: all 0.3s ease-in-out;
  }

  /* Improve backdrop blur support across browsers */
  @supports not (backdrop-filter: blur(12px)) {
    .navbar {
      background: rgba(255, 255, 255, 0.95);
    }

    .navbar.dark-theme {
      background: rgba(31, 41, 55, 0.95);
    }
  }
</style>

<script>
  // TypeScript interfaces for better type safety
  interface NavbarElements {
    navbar: HTMLElement | null;
    backdrop: HTMLElement | null;
    logo: HTMLElement | null;
    mobileMenuButton: HTMLElement | null;
    mobileMenu: HTMLElement | null;
    navbarLinks: NodeListOf<HTMLElement>;
  }

  interface NavbarTheme {
    backdrop: string;
    logo: string;
    links: string;
  }

  interface NavbarThemes {
    light: NavbarTheme;
    dark: NavbarTheme;
  }

  type ThemeType = 'light' | 'dark';

  // Dynamic Navbar Theme Adaptation System
  class DynamicNavbar {
    private elements: NavbarElements;
    private currentTheme: ThemeType = 'light';
    private observer: IntersectionObserver | null = null;

    private readonly themes: NavbarThemes = {
      light: {
        backdrop: '', // Default, no specific class needed
        logo: '',
        links: '',
      },
      dark: {
        backdrop: 'dark-theme', // Class to apply for dark theme
        logo: '',
        links: '',
      },
    };

    constructor() {
      this.elements = this.getElements();
      this.init();
    }

    private getElements(): NavbarElements {
      return {
        navbar: document.getElementById('dynamic-navbar'),
        backdrop: document.getElementById('dynamic-navbar'), // Same as navbar for this implementation
        logo: document.getElementById('navbar-logo'),
        mobileMenuButton: document.getElementById('mobile-menu-button'),
        mobileMenu: document.getElementById('mobile-menu'),
        navbarLinks: document.querySelectorAll('.navbar-link, .mobile-nav-link'),
      };
    }

    private init(): void {
      if (!this.elements.navbar) {
        console.warn('Dynamic navbar element not found');
        return;
      }

      this.setupIntersectionObserver();
      this.setupMobileMenu();

      // Initial theme setup
      this.applyTheme('light');

      // Fallback for non-JS scenarios
      this.elements.navbar.style.display = 'block';
    }

    private setupIntersectionObserver(): void {
      if (!this.elements.navbar) return;

      const navbarHeight: number = 72; // Fixed height from CSS

      this.observer = new IntersectionObserver(
        (entries: IntersectionObserverEntry[]) => {
          entries.forEach((entry: IntersectionObserverEntry) => {
            if (entry.isIntersecting) {
              const target = entry.target as HTMLElement;
              const sectionTheme: ThemeType = (target.dataset.theme as ThemeType) || 'light';
              this.updateTheme(sectionTheme);
            }
          });
        },
        {
          rootMargin: `-${navbarHeight}px 0px -80% 0px`,
          threshold: 0,
        },
      );

      // Observe all sections with data-theme attribute
      const sections = document.querySelectorAll('[data-theme]');
      sections.forEach((section: Element) => this.observer!.observe(section));
    }

    private updateTheme(theme: ThemeType): void {
      if (this.currentTheme !== theme) {
        this.currentTheme = theme;
        this.applyTheme(theme);
      }
    }

    private applyTheme(theme: ThemeType): void {
      if (!this.elements.navbar) return;

      this.elements.navbar.dataset.theme = theme;

      const themeConfig = this.themes[theme];

      // Apply theme class to navbar
      if (themeConfig.backdrop) {
        this.elements.navbar.classList.add(themeConfig.backdrop);
      } else {
        this.elements.navbar.classList.remove('dark-theme');
      }
    }

    private setupMobileMenu(): void {
      if (!this.elements.mobileMenuButton || !this.elements.mobileMenu) return;

      // Toggle mobile menu
      this.elements.mobileMenuButton.addEventListener('click', () => {
        const isExpanded: boolean =
          this.elements.mobileMenuButton!.getAttribute('aria-expanded') === 'true';

        this.elements.mobileMenuButton!.setAttribute('aria-expanded', String(!isExpanded));
        this.elements.mobileMenuButton!.classList.toggle('active');
        this.elements.mobileMenu!.classList.toggle('active');
      });

      // Close mobile menu when clicking links
      const mobileLinks = this.elements.mobileMenu.querySelectorAll('.mobile-nav-link');
      mobileLinks.forEach((link: Element) => {
        link.addEventListener('click', () => {
          this.elements.mobileMenu!.classList.remove('active');
          this.elements.mobileMenuButton!.classList.remove('active');
          this.elements.mobileMenuButton!.setAttribute('aria-expanded', 'false');
        });
      });

      // Close mobile menu when clicking close button
      const closeBtn = this.elements.mobileMenu.querySelector('.mobile-close-btn');
      if (closeBtn) {
        closeBtn.addEventListener('click', () => {
          this.elements.mobileMenu!.classList.remove('active');
          this.elements.mobileMenuButton!.classList.remove('active');
          this.elements.mobileMenuButton!.setAttribute('aria-expanded', 'false');
        });
      }
    }

    // Public methods for external use
    public setTheme(theme: ThemeType): void {
      this.updateTheme(theme);
    }

    public getCurrentTheme(): ThemeType {
      return this.currentTheme;
    }
  }

  // Initialize the dynamic navbar
  document.addEventListener('DOMContentLoaded', () => {
    new DynamicNavbar();
  });

  // Re-initialize on Astro page loads (for SPA navigation)
  document.addEventListener('astro:page-load', () => {
    new DynamicNavbar();
  });
</script>
