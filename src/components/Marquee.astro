---
import {
  AirCaraibes,
  ClubMed,
  Dubreuil,
  Empruntis,
  MaVilleMonShopping,
  OlympiqueLyonnais,
  Playbac,
  Product,
  PsaBank,
  Stellantis,
  VeryChic,
} from '@assets/brand-logos';
---

<div class="container">
  <div class="scrolling-logos">
    <AirCaraibes class="logo" />
    <ClubMed class="logo" />
    <Dubreuil class="logo" />
    <Empruntis class="logo" />
    <MaVilleMonShopping class="logo" />
    <OlympiqueLyonnais class="logo" />
    <Playbac class="logo" />
    <Product class="logo" />
    <PsaBank class="logo scale-200" />
    <Stellantis class="logo" />
    <VeryChic class="logo" />
    <AirCaraibes class="logo" />
    <ClubMed class="logo" />
    <Dubreuil class="logo" />
    <Empruntis class="logo" />
    <MaVilleMonShopping class="logo" />
    <OlympiqueLyonnais class="logo" />
    <Playbac class="logo" />
    <Product class="logo" />
    <PsaBank class="logo" />
    <Stellantis class="logo" />
    <VeryChic class="logo" />
  </div>
</div>

<style>
  .container {
    overflow: hidden;
    max-width: 100%;
    padding: 10px 0;
    margin: 15px auto;
    mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0) 0%,
      rgb(0, 0, 0) 10%,
      rgb(0, 0, 0) 90%,
      rgba(0, 0, 0, 0) 100%
    );
  }

  .scrolling-logos {
    display: flex;
    width: max-content; /* width based on content */
    animation: scroll-left 45s linear infinite;
  }

  .logo {
    height: 35px;
    margin-right: 70px;
    filter: grayscale(100%);
    object-fit: contain;
  }

  @keyframes scroll-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>
