<style>
  .container {
    --s: 150px;
    --margin: 50px;
    --d: 50s;
    --n: 4;
    display: flex;
    align-items: center;
    /* width: calc(var(--n) * (var(--s) + var(--margin))); */
    width: 100%;
    height: auto;
    overflow: hidden;
  }

  .container > * {
    width: var(--s);
    height: 50px;
    flex-shrink: 0;
    display: block;
    margin: 0;
    offset: shape(
      from calc(var(--s) / -2) 50%,
      hline by calc(sibling-count() * (var(--s) + var(--margin)))
    );
    animation: moveX var(--d) linear infinite
      calc(-1 * sibling-index() * var(--d) / sibling-count());
  }

  @keyframes moveX {
    to {
      offset-distance: 100%;
    }
  }
</style>
