---
import { useTranslations } from '@/i18n';
import type { LanguageCode } from '@/config/language';

import Logo from '@/assets/images/svg/logo.svg';

import {
  DesktopAboutUsDropdown,
  DesktopFeaturesDropdown,
  DesktopUseCasesDropdown,
  NavbarMobile,
} from '@ui/navbar';

interface Props {
  lang: LanguageCode;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header id="dynamic-navbar">
  <nav class="navbar container-custom" role="navigation" aria-label="Main navigation">
    <div class="navbar-container">
      <!-- Logo -->
      <div class="navbar-logo">
        <a href={`/a360-gh-pages/${lang}`} aria-label="Project homepage" id="navbar-logo">
          <Logo id="logo" class="fill-white" />
        </a>
      </div>

      <!-- Desktop Navigation Links -->
      <div class="navbar-menu desktop-menu">
        <ul class="navbar-nav" role="menubar">
          <!-- Features with Mega Menu -->
          <DesktopFeaturesDropdown />

          <!-- Use Cases with Mega Menu -->
          <DesktopUseCasesDropdown />

          <!-- About Us -->
          <DesktopAboutUsDropdown />

          <li class="transition-colors duration-300 hover:text-gray-400">
            <a href={`/a360-gh-pages/${lang}/testimonials`}> {t('nav.testimonials')} </a>
          </li>
        </ul>
      </div>

      <!-- Desktop Auth Links -->
      <div class="navbar-auth desktop-auth">
        <a href="/login" class="auth-link login">{t('nav.login')}</a>
        <a href={`/a360-gh-pages/${lang}/request-demo`} class="auth-link demo"
          >{t('nav.bookDemo')}</a
        >
      </div>

      <!-- Mobile Hamburger Button -->
      <button
        class="mobile-menu-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="mobile-menu-button"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu">
      <NavbarMobile />
    </div>
  </nav>
</header>

<style>
  /* Dropdown open state for click/tap interaction */
  [data-dropdown].is-open [data-dropdown-menu] {
    pointer-events: auto;
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  [data-dropdown].is-open [data-dropdown-trigger] svg {
    transform: rotate(180deg);
  }

  /* Note: Hover on desktop is handled by Tailwind's group-hover/dropdown classes */
  /* No need for @media (hover: hover) since Tailwind v4 handles it automatically */

  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background-color: rgba(255, 255, 255, 0.01);
    backdrop-filter: blur(24px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
  }

  /* Dark theme styles for the header */
  header.dark-theme {
    background-color: rgb(255, 255, 255);
    border-bottom: 1px solid rgba(167, 166, 166, 0.247);
  }

  header.dark-theme .navbar-logo a {
    color: rgb(0, 0, 0);
    fill: rgb(0, 0, 0);
  }

  header.dark-theme .navbar-logo #logo {
    fill: black;
  }

  header.dark-theme .navbar-link {
    color: #000 !important;
  }

  header.dark-theme .navbar-nav {
    color: black;
  }

  header.dark-theme .navbar-link:hover {
    color: #000;
  }

  header.dark-theme .auth-link {
    color: #000;
  }

  header.dark-theme .auth-link:hover {
    color: #000;
  }

  header.dark-theme .auth-link.demo {
    background: #f771bf;
    color: white;
  }

  header.dark-theme .mobile-menu-toggle .hamburger-line {
    background-color: black;
  }

  header.dark-theme .mobile-menu-overlay {
    background: rgba(31, 41, 55, 0.98);
  }

  header.dark-theme .mobile-menu-content {
    background-color: rgba(31, 41, 55, 1);
  }

  header.dark-theme .mobile-nav-link {
    color: #d1d5db;
  }

  header.dark-theme .mobile-nav-link:hover {
    color: white;
  }

  header.dark-theme .mobile-auth-link {
    color: #d1d5db;
  }

  header.dark-theme .mobile-auth-link:hover {
    color: white;
  }

  header.dark-theme .mobile-close-btn {
    color: #d1d5db;
  }

  header.dark-theme .mobile-close-btn:hover {
    color: white;
    background-color: rgba(255, 255, 255, 0.1);
  }

  .navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .navbar-logo .logo-image {
    height: 24px;
    width: auto;
  }

  /* Desktop Menu Styles */
  .desktop-menu {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .navbar-nav {
    display: flex;
    align-items: center;
    gap: 40px;
    list-style: none;
    margin: 0;
    padding: 0;
    color: white;
  }

  .navbar-item {
    position: relative;
  }

  .navbar-link {
    color: white;
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    padding: 8px 0;
    transition: color 0.2s ease;
    cursor: pointer;
  }

  .navbar-link:hover {
    color: #f8fafc;
  }

  .desktop-auth {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .auth-link {
    color: white;
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    transition: color 0.2s ease-in-out;
  }

  .auth-link:hover {
    color: #f8fafc;
  }

  .auth-link.login:hover {
    color: #b8bbbe;
  }

  .auth-link.demo {
    color: #000;
    padding: 8px 16px;
    border-radius: 8px;
    transition: all 0.2s ease;
    border-color: rgba(34, 34, 34, 0.15);
    box-shadow:
      rgba(0, 0, 0, 0.12) 0px 1px 2px 0px,
      rgba(0, 0, 0, 0.08) 0px 4px 6px 0px,
      rgba(0, 0, 0, 0) 0px 0.5px 1px 1px,
      rgba(0, 0, 0, 0) 0px 4px 12px 0px,
      rgba(255, 255, 255, 0.25) 0px 1px 1px 0px inset;
    background: radial-gradient(
        39.8% 100% at 50% 0%,
        rgb(255, 255, 255) 0%,
        rgb(249, 249, 250) 100%
      )
      rgba(0, 0, 0, 0);
  }

  .auth-link.demo:hover {
    color: black;
  }

  /* Mobile Menu Toggle Button */
  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    border-radius: 8px;
    transition: background-color 0.2s ease;
  }

  .mobile-menu-toggle:hover {
    background-color: rgba(255, 255, 255, 0.05);
  }

  .mobile-menu-toggle:focus {
    outline: 2px solid #5e51f8;
    outline-offset: 2px;
  }

  .hamburger-line {
    width: 24px;
    height: 2px;
    background-color: white;
    margin: 2px 0;
    transition: all 0.3s ease;
    border-radius: 1px;
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -6px);
  }

  /* Mobile Menu Overlay */
  .mobile-menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: white;
    z-index: 999;
    transform: translateY(-100%);
    transition: transform 0.3s ease;
    overflow-y: hidden;
  }

  .mobile-menu-overlay.active {
    transform: translateY(0);
  }

  .mobile-menu-content {
    height: 100vh;
    padding: 20px;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    background-color: white;
  }

  /* Mobile Auth Header */
  .mobile-auth {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
    padding-top: 20px;
  }

  .mobile-auth-link {
    color: #374151;
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    padding: 8px 16px;
    border-radius: 8px;
    transition: all 0.2s ease;
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .mobile-auth-link.demo {
    background: #5e51f8;
    color: white;
  }

  .mobile-close-btn {
    background: none;
    border: none;
    padding: 10px;
    cursor: pointer;
    color: #6b7280;
    border-radius: 8px;
    transition: background-color 0.2s ease;
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-close-btn:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }

  /* Mobile Navigation Sections */
  .mobile-nav-section {
    border-bottom: 1px solid #f3f4f6;
    display: flex;
    flex-direction: column;
  }

  .mobile-nav-link {
    display: block;
    padding: 20px 0;
    font-size: 18px;
    font-weight: 500;
    color: #111827;
    text-decoration: none;
    min-height: 44px;
    display: flex;
    align-items: center;
    transition: color 0.2s ease;
  }

  .mobile-nav-link:hover {
    color: #5e51f8;
  }

  /* Responsive Design */
  @media (max-width: 1280px) {
    .navbar-container {
      padding: 0 16px;
    }

    /* Hide desktop menu and auth */
    .desktop-menu,
    .desktop-auth {
      display: none;
    }

    /* Show mobile menu toggle */
    .mobile-menu-toggle {
      display: flex;
    }

    /* Ensure mobile menu is accessible */
    .mobile-menu-overlay {
      display: block;
    }
  }

  @media (min-width: 1281px) {
    /* Hide mobile elements on desktop */
    .mobile-menu-toggle,
    .mobile-menu-overlay {
      display: none;
    }
  }

  /* Ensure proper touch targets on mobile */
  @media (max-width: 1280px) {
    .mobile-nav-link,
    .mobile-auth-link,
    .mobile-close-btn {
      min-height: 44px;
      min-width: 44px;
    }
  }

  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .navbar {
      border-bottom: 2px solid #000;
    }

    .mobile-menu-overlay {
      border: 2px solid #000;
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu-overlay,
    .hamburger-line {
      transition: none;
    }
  }

  /* Fallback styles for non-JS scenarios */
  #dynamic-navbar {
    backdrop-filter: blur(12px);
  }

  /* Ensure proper contrast ratios for accessibility */
  .navbar-link:focus,
  .mobile-nav-link:focus {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  /* Enhanced mobile menu animation */
  #mobile-menu {
    transition: all 0.3s ease-in-out;
  }

  /* Improve backdrop blur support across browsers */
  @supports not (backdrop-filter: blur(12px)) {
    .navbar {
      background: rgba(255, 255, 255, 0.95);
    }

    .navbar.dark-theme {
      background: rgba(31, 41, 55, 0.95);
    }
  }
</style>

<script>
  // TypeScript interfaces for better type safety
  interface NavbarElements {
    navbar: HTMLElement | null;
    backdrop: HTMLElement | null;
    logo: HTMLElement | null;
    mobileMenuButton: HTMLElement | null;
    mobileMenu: HTMLElement | null;
    navbarLinks: NodeListOf<HTMLElement>;
  }

  interface NavbarTheme {
    backdrop: string;
    logo: string;
    links: string;
  }

  interface NavbarThemes {
    light: NavbarTheme;
    dark: NavbarTheme;
  }

  type ThemeType = 'light' | 'dark';

  // Dynamic Navbar Theme Adaptation System
  class DynamicNavbar {
    private elements: NavbarElements;
    private currentTheme: ThemeType = 'light';
    private observer: IntersectionObserver | null = null;

    private readonly themes: NavbarThemes = {
      light: {
        backdrop: '', // Default, no specific class needed
        logo: '',
        links: '',
      },
      dark: {
        backdrop: 'dark-theme', // Class to apply for dark theme
        logo: '',
        links: '',
      },
    };

    constructor() {
      this.elements = this.getElements();
      this.init();
    }

    private getElements(): NavbarElements {
      return {
        navbar: document.getElementById('dynamic-navbar'),
        backdrop: document.getElementById('dynamic-navbar'),
        logo: document.getElementById('navbar-logo'),
        mobileMenuButton: document.getElementById('mobile-menu-button'),
        mobileMenu: document.getElementById('mobile-menu'),
        navbarLinks: document.querySelectorAll('.navbar-link, .mobile-nav-link'),
      };
    }

    private init(): void {
      if (!this.elements.navbar) {
        console.warn('Dynamic navbar element not found');
        return;
      }

      this.setupIntersectionObserver();
      this.setupMobileMenu();

      // Initial theme setup
      this.applyTheme('light');

      // Fallback for non-JS scenarios
      this.elements.navbar.style.display = 'block';
    }

    private setupIntersectionObserver(): void {
      if (!this.elements.navbar) return;

      const navbarHeight: number = 72;

      this.observer = new IntersectionObserver(
        (entries: IntersectionObserverEntry[]) => {
          entries.forEach((entry: IntersectionObserverEntry) => {
            if (entry.isIntersecting) {
              const target = entry.target as HTMLElement;
              const sectionTheme: ThemeType = (target.dataset.theme as ThemeType) || 'light';
              this.updateTheme(sectionTheme);
            }
          });
        },
        {
          rootMargin: `-${navbarHeight}px 0px -80% 0px`,
          threshold: 0,
        },
      );

      const sections = document.querySelectorAll('[data-theme]');
      sections.forEach((section: Element) => this.observer!.observe(section));
    }

    private updateTheme(theme: ThemeType): void {
      if (this.currentTheme !== theme) {
        this.currentTheme = theme;
        this.applyTheme(theme);
      }
    }

    private applyTheme(theme: ThemeType): void {
      if (!this.elements.navbar) return;

      this.elements.navbar.dataset.theme = theme;

      const themeConfig = this.themes[theme];

      if (themeConfig.backdrop) {
        this.elements.navbar.classList.add(themeConfig.backdrop);
      } else {
        this.elements.navbar.classList.remove('dark-theme');
      }
    }

    private setupMobileMenu(): void {
      if (!this.elements.mobileMenuButton || !this.elements.mobileMenu) return;

      this.elements.mobileMenuButton.addEventListener('click', () => {
        const isExpanded: boolean =
          this.elements.mobileMenuButton!.getAttribute('aria-expanded') === 'true';

        this.elements.mobileMenuButton!.setAttribute('aria-expanded', String(!isExpanded));
        this.elements.mobileMenuButton!.classList.toggle('active');
        this.elements.mobileMenu!.classList.toggle('active');
      });

      const mobileLinks = this.elements.mobileMenu.querySelectorAll('.mobile-nav-link');
      mobileLinks.forEach((link: Element) => {
        link.addEventListener('click', () => {
          this.elements.mobileMenu!.classList.remove('active');
          this.elements.mobileMenuButton!.classList.remove('active');
          this.elements.mobileMenuButton!.setAttribute('aria-expanded', 'false');
        });
      });

      const closeBtn = this.elements.mobileMenu.querySelector('.mobile-close-btn');
      if (closeBtn) {
        closeBtn.addEventListener('click', () => {
          this.elements.mobileMenu!.classList.remove('active');
          this.elements.mobileMenuButton!.classList.remove('active');
          this.elements.mobileMenuButton!.setAttribute('aria-expanded', 'false');
        });
      }
    }

    public setTheme(theme: ThemeType): void {
      this.updateTheme(theme);
    }

    public getCurrentTheme(): ThemeType {
      return this.currentTheme;
    }
  }

  // Initialize the dynamic navbar
  document.addEventListener('DOMContentLoaded', () => {
    new DynamicNavbar();
  });

  // Re-initialize on Astro page loads (for SPA navigation)
  document.addEventListener('astro:page-load', () => {
    new DynamicNavbar();
  });
</script>

<script>
  /**
   * Dropdown Menu Enhancement
   * Progressive enhancement for touch devices and accessibility
   */
  class DropdownMenu {
    private dropdownContainer: HTMLElement;
    private trigger: HTMLButtonElement;
    private menu: HTMLElement;
    private isOpen: boolean = false;
    private static instances: DropdownMenu[] = [];

    constructor(container: HTMLElement) {
      this.dropdownContainer = container;
      this.trigger = container.querySelector('[data-dropdown-trigger]') as HTMLButtonElement;
      this.menu = container.querySelector('[data-dropdown-menu]') as HTMLElement;

      if (!this.trigger || !this.menu) {
        console.warn('Dropdown trigger or menu not found');
        return;
      }

      DropdownMenu.instances.push(this);
      this.init();
    }

    private init(): void {
      // Handle click/tap events for touch devices
      this.trigger.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        this.toggle();
      });

      // Close on click outside
      document.addEventListener('click', (e) => {
        if (!this.dropdownContainer.contains(e.target as Node)) {
          this.close();
        }
      });

      // Close on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.isOpen) {
          this.close();
          this.trigger.focus();
        }
      });

      // Close dropdown when clicking on menu items
      const menuLinks = this.menu.querySelectorAll('a[role="menuitem"]');
      menuLinks.forEach((link) => {
        link.addEventListener('click', () => {
          this.close();
        });
      });
    }

    private toggle(): void {
      if (this.isOpen) {
        this.close();
      } else {
        this.open();
      }
    }

    private open(): void {
      // Close all other dropdowns before opening this one
      DropdownMenu.closeAll(this);

      this.isOpen = true;
      this.trigger.setAttribute('aria-expanded', 'true');

      // Add classes for open state - using pointer-events instead of visibility
      this.dropdownContainer.classList.add('is-open');
      this.menu.classList.remove(
        'pointer-events-none',
        'opacity-0',
        'scale-95',
        '-translate-y-2.5',
      );
      this.menu.classList.add('pointer-events-auto', 'opacity-100', 'scale-100', 'translate-y-0');
    }

    private close(): void {
      this.isOpen = false;
      this.trigger.setAttribute('aria-expanded', 'false');

      // Remove open state classes - using pointer-events instead of visibility
      this.dropdownContainer.classList.remove('is-open');
      this.menu.classList.add('pointer-events-none', 'opacity-0', 'scale-95', '-translate-y-2.5');
      this.menu.classList.remove(
        'pointer-events-auto',
        'opacity-100',
        'scale-100',
        'translate-y-0',
      );
    }

    // Static method to close all dropdowns except the current one
    private static closeAll(exceptInstance?: DropdownMenu): void {
      DropdownMenu.instances.forEach((instance) => {
        if (instance !== exceptInstance && instance.isOpen) {
          instance.close();
        }
      });
    }

    public getIsOpen(): boolean {
      return this.isOpen;
    }
  }

  // Initialize all dropdowns
  function initDropdowns(): void {
    // Clear previous instances when re-initializing
    (DropdownMenu as any).instances = [];

    const dropdowns = document.querySelectorAll('[data-dropdown]');
    dropdowns.forEach((dropdown) => {
      new DropdownMenu(dropdown as HTMLElement);
    });
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', initDropdowns);

  // Re-initialize after Astro view transitions
  document.addEventListener('astro:page-load', initDropdowns);
</script>
